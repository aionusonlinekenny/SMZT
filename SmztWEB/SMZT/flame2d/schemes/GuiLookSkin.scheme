	<LookNFeel Filename="GuiLook.looknfeel" />
	<WindowRendererSet Filename="CEGUIFalagardWRBase" />
	

	<!--***************************************************************************************************************************************************
	***************************************************           aothor: wxz    ******************************************************************************
	Button       按钮[Button(默认按钮) BlueButton(蓝色按钮) OrangeButton(橙色按钮) CloseButton(关闭按钮)]
	Image        图片[StaticImage]
	Label        文本[StaticText]  StaticTextBox[文本盒子] 
	ImageButton  带图片的按钮[ImageButton(图片按钮)  GuiLook/DefaultImageButton(默认的图片按钮) ThreeStretchImageButton(可拉伸 可写字 (需要切图)图片按钮)  一张图片 赋值方式 set:tj2common 	   image:horseBtnLeft ]
	Panel	     面板[FrameWindow(小面板)  BigWindow(大面板)] 
	Tab          标签页[TabControl]
	Scrollbar    滚动条[HorizontalScrollbar(水平滚动条)   VerticalScrollbar(垂直滚动条)的 GuiLook/VerticalScrollbarThumb   对应LOOKFEEL中的GuiLook/ThreeStretchImageButtonVert]
	RadioButton  单选按钮[RadioButton]
	BG			 背景1 CommonBG	CommonBg2
	MenuItem	菜单 PopupMenu MenuItem
				******************************************************************************
	************************************************************************************************************************************************************ -->
	<!-- 资源 tj2common 蓝色按钮-->
	<FalagardMapping WindowType="GlossySerpent/BlueButton" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GlossySerpent/BlueButton" />	
	<!-- 资源 tj2common 橙色按钮-->
	<FalagardMapping WindowType="GlossySerpent/OrangeButton" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GlossySerpent/OrangeButton" />
	<!-- 资源 skins 红色按钮-->
	<FalagardMapping WindowType="GlossySerpent/RedButton" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GlossySerpent/RedButton" />
	<!-- 资源 tj2common 系统提示的按钮-->
	<FalagardMapping WindowType="GlossySerpent/SystemButton" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GlossySerpent/SystemButton" />
	<!-- 资源 tj2common 关闭按钮-->
	<FalagardMapping WindowType="GuiLook/CloseButton"      TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GuiLook/CloseButton" />	
	<!-- 资源 mainUI1 公共模块按钮-->
	<FalagardMapping WindowType="GuiLook/ModelButton" TargetType="CEGUI/PushButton" Renderer="Falagard/Button" LookNFeel="GuiLook/ModelButton"/>	
	<!-- 资源 mainUI1 默认按钮(不切片的 可写字 有3或4帧状态 ) -->
	<FalagardMapping WindowType="GuiLook/DefaultButton" TargetType="CEGUI/PushButton" Renderer="Falagard/Button" LookNFeel="GuiLook/DefaultButton"/>
	
	<!-- 资源 skin 排序按钮-->
	<FalagardMapping WindowType="GlossySerpent/SortButton" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GlossySerpent/SortButton" />	
	<!--滑块-->
	<FalagardMapping WindowType="GuiLook/Slider"      TargetType="CEGUI/Slider"      Renderer="Falagard/Slider"  LookNFeel="GuiLook/Slider" />
	<FalagardMapping WindowType="GuiLook/SliderThumb" TargetType="CEGUI/Thumb" Renderer="Falagard/Button"  LookNFeel="GuiLook/SliderThumb" />
	<!--菜单-->
	<FalagardMapping WindowType="GuiLook/MenuItem"  TargetType="CEGUI/MenuItem"  Renderer="Falagard/MenuItem"  LookNFeel="GuiLook/MenuItem" />
	<FalagardMapping WindowType="GuiLook/PopupMenu" TargetType="CEGUI/PopupMenu" Renderer="Falagard/PopupMenu" LookNFeel="GuiLook/PopupMenu" />
	<!--复选按钮-->
	<FalagardMapping WindowType="GuiLook/Checkbox"    TargetType="CEGUI/Checkbox"    Renderer="Falagard/ToggleButton" LookNFeel="GuiLook/Checkbox" />
	<!--复选按钮-->
	<FalagardMapping WindowType="GuiLook/CommonCheckbox"    TargetType="CEGUI/Checkbox"    Renderer="Falagard/ToggleButton" LookNFeel="GuiLook/CommonCheckbox" />
	<!--单选Tab按钮-->
	<FalagardMapping WindowType="GuiLook/RadioTab" TargetType="CEGUI/RadioButton" Renderer="Falagard/ToggleButton" LookNFeel="GuiLook/RadioTab" />
	
	<!--                                       *************                      Image        图片      ************************************                                       -->
	<!-- 图片  相当于image -->
	<FalagardMapping WindowType="GuiLook/StaticImage" TargetType="DefaultWindow" Renderer="Falagard/StaticImage" LookNFeel="GuiLook/StaticImage" />
	
	<!--                                       *************                      Label        文本       ************************************                                       -->
		<!-- 文本  相当于label -->
	<FalagardMapping WindowType="GuiLook/StaticText"  TargetType="DefaultWindow" Renderer="Falagard/Default"  LookNFeel="GuiLook/StaticText" />
	<!--富文本-->
	<FalagardMapping WindowType="GuiLook/RichTextBox" TargetType="CEGUI/RichTextBox"   Renderer="Falagard/RichTextBox"   LookNFeel="GuiLook/RichTextBox" />
	<!-- 资源 tj2common (编辑器里面用不了)  自定义expText:FlameWindow 兼容
	 用法var fst:FalagardStaticText = expText.getWindowRenderer() as FalagardStaticText;
			fst.lines = 6;(显示多少行)
			fst.color = 0xFFFF0000;(设置字体颜色)
			expText.width = 50;(设置宽高)
			expText.heigh = 100;
			也可以在layout配上  两个弄一个就行 <Property Name="VertFormatting" Value="TopAligned" />要想换行不能设置居中
			 <Property Name="LineSpace" Value="6" />
			//不显示背景
			 <Property Name="FrameEnabled" Value="False" />
			 <Property Name="BackgroundEnabled" Value="False" />
			//鼠标经过禁用
			<Property Name="MousePassThroughEnabled" Value="True" />

			
	-->
	<FalagardMapping WindowType="GuiLook/StaticTextBox"  TargetType="DefaultWindow" Renderer="Falagard/StaticText"  LookNFeel="GuiLook/StaticTextBox" />	
	
	<!--*************         ImageButton  带图片的按钮[ImageButton(图片按钮)]   **************************************************** -->
	<!--图片按钮-->
	<FalagardMapping WindowType="GuiLook/ImageButton" TargetType="CEGUI/PushButton" Renderer="Falagard/Button" LookNFeel="GuiLook/ImageButton"/>
	<!--默认图片按钮-->
	<FalagardMapping WindowType="GuiLook/DefaultImageButton" TargetType="CEGUI/PushButton" Renderer="Falagard/Button" LookNFeel="GuiLook/DefaultImageButton"/>
	<!--可拉伸 可写字 (需要切图)图片按钮(一张图片 其他用颜色表示不同状态)-->
	<FalagardMapping WindowType="GuiLook/ThreeStretchImageButton" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GuiLook/ThreeStretchImageButton" />
	<!--带滚动条面板-->
	<FalagardMapping WindowType="GuiLook/ScrollablePane" TargetType="CEGUI/ScrollablePane" Renderer="Falagard/ScrollablePane" LookNFeel="GuiLook/ScrollablePane" />
	<!--带滚动条面板  mainUI-->
	<FalagardMapping WindowType="GuiLook/MainScrollablePane" TargetType="CEGUI/ScrollablePane" Renderer="Falagard/ScrollablePane" LookNFeel="GuiLook/MainScrollablePane" />
	
	<!--                                       *************                      面板        ************************************                                       -->
	<!--新窗口面板-->
	<FalagardMapping WindowType="GuiLook/NewWindow"  TargetType="CEGUI/FrameWindow" Renderer="Falagard/FrameWindow"  LookNFeel="GuiLook/NewWindow" />
	<!--面板抬头-->
	<FalagardMapping WindowType="GuiLook/NewTitlebar" TargetType="CEGUI/Titlebar" Renderer="Falagard/Titlebar" LookNFeel="GuiLook/NewTitlebar"/>
	<!--透明抬头-->
	<FalagardMapping WindowType="GuiLook/TransparentTitlebar" TargetType="CEGUI/Titlebar" Renderer="Falagard/Titlebar" LookNFeel="GuiLook/TransparentTitlebar"/>
	<!--弹出面板-->
	<FalagardMapping WindowType="GuiLook/Panel2" TargetType="CEGUI/FrameWindow" Renderer="Falagard/FrameWindow" LookNFeel="GuiLook/Panel2"/>
	<FalagardMapping WindowType="GuiLook/Panel2Titlebar" TargetType="CEGUI/Titlebar" Renderer="Falagard/Titlebar" LookNFeel="GuiLook/Panel2Titlebar"/>	
	<!--图片背景面板-->
	<FalagardMapping WindowType="GuiLook/ImageBgPanel"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/ImageBgPanel" />
	<FalagardMapping WindowType="GuiLook/Common1Panel1"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/Common1Panel1" />
	<FalagardMapping WindowType="GuiLook/Common1Panel2"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/Common1Panel2" />
	
	<!--                                       *************                      背景        ************************************                                       -->	
	<!--背景1  资源 skin-->
	<FalagardMapping WindowType="GuiLook/CommonBG"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/CommonBG" />
	<!--背景2  资源 skin-->
	<FalagardMapping WindowType="GuiLook/CommonBg2"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/CommonBg2" />
	<!--背景3  资源 skin-->
	<FalagardMapping WindowType="GuiLook/CommonBg3"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/CommonBg3" />
	<!--背景4  资源 skin-->
	<FalagardMapping WindowType="GuiLook/CommonBg4"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/CommonBg4" />
	<!--输入框  资源 skin-->
	<FalagardMapping WindowType="GuiLook/inputBg"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/inputBg" />
	<!--红框  资源 skin-->
	<FalagardMapping WindowType="GuiLook/redBg"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/redBg" />
	<!--黄框  资源 skin-->
	<FalagardMapping WindowType="GuiLook/yellowBg"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/yellowBg" />
	<!--黄框  资源 skin-->
	<FalagardMapping WindowType="GuiLook/renderBG"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/renderBG" />
	<!--文本背景  资源 skin-->
	<FalagardMapping WindowType="GuiLook/TextBG"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/TextBG" />
	
	<FalagardMapping WindowType="GuiLook/Tooltip" TargetType="CEGUI/Tooltip" Renderer="Falagard/Tooltip" LookNFeel="GuiLook/Tooltip" />
	
	<!--按钮滤镜  资源 skins-->
	<FalagardMapping WindowType="GuiLook/ButtonFilter"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GuiLook/ButtonFilter" />
	<!--       *************                      Tab  页标签      ************************************      -->
	<!-- TabControl
	1.拉一个TabControl 里面带着TabButton(就是标签按钮  样式在lookfeel设置TabButton的样式就可以)
````2.在TabControl上面拉一个TabContentPane(好像是tab页的背景)
	3.在TabContentPane上面拉defaultWindow(就是每个标签页切换的面板)
	 -->
	<FalagardMapping WindowType="GuiLook/TabControl" TargetType="CEGUI/TabControl" Renderer="Falagard/TabControl" LookNFeel="GuiLook/TabControl" />
	 
	 
	<!-- 资源 tj2common 内嵌-->
	<FalagardMapping WindowType="GuiLook/TabButton"  TargetType="CEGUI/TabButton"  Renderer="Falagard/TabButton"  LookNFeel="GuiLook/TabButton" />
	
	
	
	<!-- 资源 tj2common -->
	<FalagardMapping WindowType="GuiLook/TabContentPane"    TargetType="DefaultWindow"    Renderer="Falagard/Default"    LookNFeel="GuiLook/TabContentPane" />
	<FalagardMapping WindowType="GuiLook/TabButtonPane"    TargetType="DefaultWindow"    Renderer="Falagard/Default"    LookNFeel="GuiLook/TabButtonPane" />
	


	
	
	
	<!-- 资源 tj2uispecial1 tj2common  内嵌  页标签按钮左右翻页的按钮-->
	<FalagardMapping WindowType="GlossySerpent/GlyphButton" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button" LookNFeel="GlossySerpent/GlyphButton" />
	
	
	
	
	
	<!--       *************                     Scrollbar    滚动条      ************************************      -->
	<!-- 资源 tj2common   水平滚动条-->
	<FalagardMapping WindowType="GuiLook/HorizontalScrollbar" TargetType="CEGUI/Scrollbar" Renderer="Falagard/Scrollbar" LookNFeel="GuiLook/HorizontalScrollbar" />
	<FalagardMapping WindowType="GuiLook/HorizontalScrollbarThumb" TargetType="CEGUI/Thumb" Renderer="Falagard/Button" LookNFeel="GuiLook/HorizontalScrollbarThumb" />
	<!-- 资源 tj2common 垂直滚动条 -->
	<FalagardMapping WindowType="GuiLook/VerticalScrollbar"   TargetType="CEGUI/Scrollbar" Renderer="Falagard/Scrollbar" LookNFeel="GuiLook/VerticalScrollbar" />
	<!-- 资源 tj2common -->
	<FalagardMapping WindowType="GuiLook/VerticalScrollbarThumb"   TargetType="CEGUI/Thumb" Renderer="Falagard/Button" LookNFeel="GuiLook/ThreeStretchImageButtonVert" />
	
	
	<!-- 资源 mainUI1 垂直滚动条2 -->
	<FalagardMapping WindowType="GuiLook/MainVerticalScrollbar"   TargetType="CEGUI/Scrollbar" Renderer="Falagard/Scrollbar" LookNFeel="GuiLook/MainVerticalScrollbar" />

	
	
	<!--       *************                     RadioButton  单选按钮	     ************************************      -->
	<FalagardMapping WindowType="GuiLook/RadioButton" TargetType="CEGUI/RadioButton" Renderer="Falagard/ToggleButton" LookNFeel="GuiLook/RadioButton" />
	<FalagardMapping WindowType="GuiLook/CommonRadioButton"  TargetType="CEGUI/RadioButton" Renderer="Falagard/ToggleButton"   LookNFeel="GuiLook/CommonRadioButton" />
	<FalagardMapping WindowType="GuiLook/RankRadioButton"  TargetType="CEGUI/RadioButton" Renderer="Falagard/ToggleButton"   LookNFeel="GuiLook/RankRadioButton" />
	
	
	<!--       *************                     DataGroup  数据组	  带渲染器   ************************************      -->
	<FalagardMapping WindowType="GuiLook/DataGroup" TargetType="CEGUI/DataGroup" Renderer="Falagard/DataGroup" LookNFeel="GuiLook/DataGroup" />
	<FalagardMapping WindowType="GuiLook/RedDataGroup" TargetType="CEGUI/DataGroup" Renderer="Falagard/DataGroup" LookNFeel="GuiLook/RedDataGroup" />
	
	<FalagardMapping WindowType="GuiLook/RedVerticalScrollbar"   TargetType="CEGUI/Scrollbar" Renderer="Falagard/Scrollbar" LookNFeel="GuiLook/RedVerticalScrollbar" />
	
	<!-- 资源 tj2common  未用到-->
	<!--<FalagardMapping WindowType="GlossySerpent/GroupBox" TargetType="CEGUI/GroupBox"   Renderer="Falagard/Default"   LookNFeel="GlossySerpent/GroupBox" />	-->
	<!--未用到-->
	<FalagardMapping WindowType="GlossySerpent/ThreeStretchImage"      TargetType="DefaultWindow"  Renderer="Falagard/Default" LookNFeel="GlossySerpent/ThreeStretchImage" />   
	<!--竖3切片-->
	<FalagardMapping WindowType="GlossySerpent/ThreeVStretchImage"      TargetType="DefaultWindow"  Renderer="Falagard/Default" LookNFeel="GlossySerpent/ThreeVStretchImage" />   
	<!--列表头-->
	<FalagardMapping WindowType="GlossySerpent/HeaderList"      TargetType="DefaultWindow"  Renderer="Falagard/Default" LookNFeel="GlossySerpent/HeaderList" />   
	<!--九切片-->
	<FalagardMapping WindowType="GlossySerpent/NineStretchImage"      TargetType="DefaultWindow"  Renderer="Falagard/Default" LookNFeel="GlossySerpent/NineStretchImage" />   
	
	<!-- DataGrid 不能用-->
	<FalagardMapping WindowType="GuiLook/DataGrid" TargetType="CEGUI/DataGrid" Renderer="Falagard/DataGrid" LookNFeel="GuiLook/DataGrid" />
	<FalagardMapping WindowType="GuiLook/GridItem" TargetType="CEGUI/GridItem" Renderer="Falagard/GridItem" LookNFeel="GuiLook/GridItem" />
	<FalagardMapping WindowType="GuiLook/SkillGridItem" TargetType="CEGUI/GridItem" Renderer="Falagard/GridItem" LookNFeel="GuiLook/SkillGridItem" />
	<!-- 资源 tj2common 背包分割线-->
	<FalagardMapping WindowType="GuiLook/Line"  TargetType="DefaultWindow" Renderer="Falagard/Default"  LookNFeel="GuiLook/Line" />
	<!-- ******************************************************************** wxz end****************************************************************** -->
	
	
	<!-- ******************************************************************** 王晓晔 ****************************************************************** -->
	<FalagardMapping WindowType="GuiLook/ComboEditbox"  TargetType="CEGUI/Editbox"	 	Renderer="Falagard/Editbox" 		LookNFeel="GuiLook/ComboEditbox" />
	<FalagardMapping WindowType="GuiLook/Editbox"       TargetType="CEGUI/Editbox"      Renderer="Falagard/Editbox"         LookNFeel="GuiLook/Editbox" />
	<!--多行文本-->
	<FalagardMapping WindowType="GuiLook/MultiLineEditbox" TargetType="CEGUI/MultiLineEditbox" Renderer="Falagard/MultiLineEditbox" LookNFeel="GuiLook/MultiLineEditbox" />
	<FalagardMapping WindowType="GuiLook/Combobox"		TargetType="CEGUI/Combobox"	 	Renderer="Falagard/Default" 		LookNFeel="GuiLook/Combobox" />
	<FalagardMapping WindowType="GuiLook/ComboDropList" TargetType="CEGUI/ComboDropList" Renderer="Falagard/Listbox" 		LookNFeel="GuiLook/ComboDropList" />
	<FalagardMapping WindowType="GuiLook/Listbox"           	TargetType="CEGUI/Listbox"           Renderer="Falagard/Listbox"           LookNFeel="GuiLook/Listbox" />
	<FalagardMapping WindowType="GuiLook/SwitchListBox"         TargetType="DefaultWindow"           Renderer="Falagard/Default"           LookNFeel="GuiLook/SwitchListBox" />
	
	<FalagardMapping WindowType="GlossySerpent/GlyphButtonCombo" TargetType="CEGUI/PushButton"  Renderer="Falagard/Button" LookNFeel="GlossySerpent/GlyphButtonCombo" />
	<!-- ********************************************************************************************************************************************** -->
	
	
	<!--<FalagardMapping WindowType="GlossySerpent/LightBlueW"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GlossySerpent/LightBlueW" />
	<FalagardMapping WindowType="GlossySerpent/LightYellow"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GlossySerpent/LightYellow" />
  <FalagardMapping WindowType="GlossySerpent/GrayPanel"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GlossySerpent/GrayPanel" />
	<FalagardMapping WindowType="GlossySerpent/MovieSceneBg"      TargetType="DefaultWindow"  Renderer="Falagard/Default"       LookNFeel="GlossySerpent/MovieSceneBg" />
  <FalagardMapping WindowType="GuiLook/SimulateImageButton"    TargetType="CEGUI/PushButton"  Renderer="Falagard/Button"       LookNFeel="GuiLook/SimulateImageButton" />-->
	
	
	
	
	
	
</GUIScheme>
