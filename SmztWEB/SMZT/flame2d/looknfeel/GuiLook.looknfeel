	<!--
    ***************************************************
        GuiLook/VerticalScrollbar
    ***************************************************
    -->
	<WidgetLook name="GuiLook/VerticalScrollbar">
		<!-- WARNING: this property link seems to be problematic for the cegui layout editor. Tested with ceed_07. TODO: retest -->
		<PropertyDefinition name="ThumbSize" initialValue="23"/>
		<Property name="VerticalScrollbar" value="True"/>
		<NamedArea name="ThumbTrackArea">
			<Area>
				<!-- Assume square form of buttons; resize edges (top & bottom) accordingly -->
				<Dim type="LeftEdge">
					<AbsoluteDim value="1"/>
				</Dim>
				<Dim type="TopEdge">
					<ImageDim imageset="skin" image="VertScrollBarDownNormal" dimension="Height"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="VertScrollBarUpPushed" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GuiLook/ImageButton" nameSuffix="__auto_incbtn__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="1"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<AbsoluteDim value="11"/>
				</Dim>
				<!--<ImageDim imageset="skin" image="VertScrollBarDownNormal" dimension="Width"/>-->
				<Dim type="Height">
					<ImageDim imageset="skin" image="VertScrollBarDownNormal" dimension="Height"/>
				</Dim>
			</Area>
			<VertAlignment type="BottomAligned"/>
			<Property name="HoverImage" value="set:skin image:VertScrollBarDownHover"/>
			<Property name="NormalImage" value="set:skin image:VertScrollBarDownNormal"/>
			<Property name="PushedImage" value="set:skin image:VertScrollBarDownPushed"/>
			<Property name="DisabledImage" value="set:skin image:VertScrollBarDownDisabled"/>
		</Child>
		<Child type="GuiLook/ImageButton" nameSuffix="__auto_decbtn__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="1"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<AbsoluteDim value="11"/>
				</Dim>
				<!--<ImageDim imageset="skin" image="VertScrollBarUpHover" dimension="Width"/>-->
				<Dim type="Height">
					<ImageDim imageset="skin" image="VertScrollBarUpHover" dimension="Height"/>
				</Dim>
			</Area>
			<Property name="HoverImage" value="set:skin image:VertScrollBarUpHover"/>
			<Property name="NormalImage" value="set:skin image:VertScrollBarUpNormal"/>
			<Property name="PushedImage" value="set:skin image:VertScrollBarUpPushed"/>
			<Property name="DisabledImage" value="set:skin image:VertScrollBarUpDisabled"/>
		</Child>
		<Child type="GuiLook/VerticalScrollbarThumb" nameSuffix="__auto_thumb__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="1"/>
				</Dim>
				<Dim type="TopEdge">
					<ImageDim imageset="skin" image="VertScrollBarDownNormal" dimension="Height"/>
				</Dim>
				<Dim type="Width">
					<AbsoluteDim value="11"/>
					<!--<ImageDim imageset="skin" image="VertScrollBarDownNormal" dimension="Width"/>-->
				</Dim>
				<Dim type="Height">
					<PropertyDim name="ThumbSize"/>
				</Dim>
			</Area>
			<Property name="VertFree" value="True"/>
			<Property name="TopImage" value="set:skin image:VertScrollBarThumbTop"/>
			<Property name="BottomImage" value="set:skin image:VertScrollBarThumbBottom"/>
			<Property name="CenterImage" value="set:skin image:VertScrollBarThumbCenter"/>
			<!--<Property name="MarkImage" value="set:tj2common image:VertScrollBarThumbMark" />
			<Property name="MarkImageHalfHeight" value="6.5" />-->
			<!-- 3 5-->
			<Property name="TopOffset" value="3"/>
			<Property name="BottomOffset" value="5"/>
		</Child>
		<ImagerySection name="main">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<ImageDim imageset="skin" image="VertScrollBarBackGroundCenter" dimension="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<Image type="TopEdge" imageset="skin" image="VertScrollBarBackGroundTop"/>
				<Image type="BottomEdge" imageset="skin" image="VertScrollBarBackGroundBottom"/>
				<Image type="Background" imageset="skin" image="VertScrollBarBackGroundCenter"/>
				<!--VertFormat type="Stretched" /-->
				<!--HorzFormat type="CentreAligned" /-->
			</FrameComponent>
		</ImagerySection>
		<StateImagery name="Enabled">
			<Layer>
				<Section section="main"/>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="main">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/ThreeStretchImageButtonVert  垂直滚动条  thum用过
    ***************************************************
    -->
	<WidgetLook name="GuiLook/ThreeStretchImageButtonVert">
		<PropertyDefinition name="TopImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="CenterImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="BottomImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="TopOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="BottomOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="MarkImage" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="MarkImageHalfHeight" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="VertImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="HorzImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="NormalImageColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="HoverImageColour" initialValue="FF151515" redrawOnWrite="true"/>
		<PropertyDefinition name="PushedImageColour" initialValue="FF7F7F7F" redrawOnWrite="true"/>
		<ImagerySection name="normal">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="TopOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="TopImage"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim name="0"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="TopOffset"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="BottomOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="CenterImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
			<ImageryComponent>
				<Area>
					<Dim type="TopEdge">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="BottomOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="BottomOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="BottomImage"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
			<ImageryComponent>
				<Area>
					<Dim type="TopEdge">
						<UnifiedDim scale="0.5" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="MarkImageHalfHeight"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="0.5" type="Height">
							<DimOperator op="Add">
								<PropertyDim name="MarkImageHalfHeight"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="MarkImage"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<!-- regular representation of the button -->
		<StateImagery name="Normal">
			<Layer>
				<Section section="normal"/>
			</Layer>
		</StateImagery>
		<!-- the cursor is hovering over the button -->
		<StateImagery name="Hover">
			<Layer>
				<Section section="normal">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- the cursor is pushing the button -->
		<StateImagery name="Pushed">
			<Layer>
				<Section section="normal">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- the cursor pushed the buton, but is moving away -->
		<StateImagery name="PushedOff">
			<Layer>
				<Section section="normal">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- the button is simply disabled -->
		<StateImagery name="Disabled">
			<Layer>
				<Section section="normal">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
