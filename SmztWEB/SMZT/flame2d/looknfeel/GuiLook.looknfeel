		<PropertyDefinition name="AnimationPosX" initialValue="-8" redrawOnWrite="true"/>
		<PropertyDefinition name="AnimationPosY" initialValue="-8" redrawOnWrite="true"/>
		<PropertyDefinition name="AnimationSize" initialValue="60" redrawOnWrite="true"/>
		<PropertyDefinition name="Polygon" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="NumTextColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="BoardWidth" initialValue="1" redrawOnWrite="true"/>
		<PropertyDefinition name="EquipIcoSub" initialValue="1" redrawOnWrite="true"/>
		<PropertyDefinition name="QHLevel" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="qhFont" initialValue="songti_14_strengh" redrawOnWrite="true"/>
		<ImagerySection name="main">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<ImageProperty name="BlockImage"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="QualityImg"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
