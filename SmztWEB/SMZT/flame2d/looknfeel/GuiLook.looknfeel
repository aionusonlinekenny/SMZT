	<!--
    ***************************************************
        GuiLook/Panel2
    ***************************************************
    -->
	<WidgetLook name="GuiLook/Panel2">
		<PropertyDefinition name="ClientAreaColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="TitlebarHeight" initialValue="38" redrawOnWrite="true"/>
		<PropertyLinkDefinition name="CaptionColour" widget="__auto_titlebar__" targetProperty="CaptionColour" initialValue="FFc6dee6"/>
		<PropertyLinkDefinition name="TitlebarFont" widget="__auto_titlebar__" targetProperty="Font"/>
		<PropertyLinkDefinition name="GlyphImage" widget="__auto_titlebar__" targetProperty="GlyphImage"/>
		<PropertyDefinition name="BackgroundPictureColour" initialValue="DFFFFFFF" redrawOnWrite="true"/>
		<Property name="AutoRenderingSurface" value="1"/>
		<Property name="RollUpEnabled" value="False"/>
		<Property name="SizingEnabled" value="False"/>
		<Property name="RiseOnClick" value="True"/>
		<NamedArea name="ClientWithTitleWithFrame">
			<Area>
				<Dim type="LeftEdge">
					<ImageDim imageset="skin" image="WindowTopLeft" dimension="Width"/>
				</Dim>
				<Dim type="TopEdge">
					<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="Panel2RightTop" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="Panel2EndMiddle" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ClientWithTitleNoFrame">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ClientNoTitleWithFrame">
			<Area>
				<Dim type="LeftEdge">
					<ImageDim imageset="skin" image="Panel2LeftTop" dimension="Width"/>
				</Dim>
				<Dim type="TopEdge">
					<ImageDim imageset="skin" image="Panel2TopMiddle" dimension="Height"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="Panel2RightTop" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="Panel2EndMiddle" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ClientNoTitleNoFrame">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GuiLook/Panel2Titlebar" nameSuffix="__auto_titlebar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge"/>
				</Dim>
				<Dim type="Height">
					<PropertyDim name="TitlebarHeight"/>
				</Dim>
			</Area>
			<Property name="AlwaysOnTop" value="False"/>
		</Child>
		<Child type="GuiLook/CloseButton" nameSuffix="__auto_closebutton__">
			<Area>
				<Dim type="LeftEdge">
					<UnifiedDim scale="1" type="LeftEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="BlueCloseNormal" dimension="Width">
								<DimOperator op="Add">
									<AbsoluteDim value="2"/>
								</DimOperator>
							</ImageDim>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0.1">
						<DimOperator op="Multiply">
							<WidgetDim widget="__auto_titlebar__" dimension="Height">
								<DimOperator op="Subtract">
									<ImageDim imageset="skin" image="BlueCloseNormal" dimension="Height"/>
								</DimOperator>
							</WidgetDim>
						</DimOperator>
					</AbsoluteDim>
				</Dim>
				<Dim type="Width">
					<ImageDim imageset="skin" image="BlueCloseNormal" dimension="Width"/>
				</Dim>
				<Dim type="Height">
					<ImageDim imageset="skin" image="BlueCloseNormal" dimension="Height"/>
				</Dim>
			</Area>
			<Property name="AlwaysOnTop" value="True"/>
			<Property name="NormalImage" value="set:skin image:BlueCloseNormal"/>
			<Property name="HoverImage" value="set:skin image:BlueCloseHover"/>
			<Property name="PushedImage" value="set:skin image:BlueClosePushed"/>
			<Property name="NonClient" value="True"/>
		</Child>
		<ImagerySection name="withtitle_frame">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="2"/>
							</DimOperator>
						</WidgetDim>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Add">
								<AbsoluteDim value="0"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="BottomLeftCorner" imageset="skin" image="Panel2LeftEnd"/>
				<Image type="BottomRightCorner" imageset="skin" image="Panel2RightEnd"/>
				<Image type="LeftEdge" imageset="skin" image="Panel2LeftMiddle"/>
				<Image type="RightEdge" imageset="skin" image="Panel2RightMiddle"/>
				<Image type="BottomEdge" imageset="skin" image="Panel2EndMiddle"/>
			</FrameComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<ImageDim imageset="skin" image="Panel2LeftTop" dimension="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="0"/>
							</DimOperator>
						</ImageDim>
					</Dim>
					<Dim type="TopEdge">
						<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="2"/>
							</DimOperator>
						</WidgetDim>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="Panel2RightTop" dimension="Width">
									<DimOperator op="Subtract">
										<AbsoluteDim value="0"/>
									</DimOperator>
								</ImageDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="Panel2EndMiddle" dimension="Height"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="Panel2Center"/>
				<ColourProperty name="ClientAreaColour"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="notitle_frame">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="TopLeftCorner" imageset="skin" image="Panel2LeftTop"/>
				<Image type="TopRightCorner" imageset="skin" image="Panel2RightTop"/>
				<Image type="BottomLeftCorner" imageset="skin" image="Panel2LeftEnd"/>
				<Image type="BottomRightCorner" imageset="skin" image="Panel2RightEnd"/>
				<Image type="LeftEdge" imageset="skin" image="Panel2LeftMiddle"/>
				<Image type="RightEdge" imageset="skin" image="Panel2RightMiddle"/>
				<Image type="BottomEdge" imageset="skin" image="Panel2EndMiddle"/>
			</FrameComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<ImageDim imageset="skin" image="Panel2LeftTop" dimension="Width"/>
					</Dim>
					<Dim type="TopEdge">
						<ImageDim imageset="skin" image="Panel2TopMiddle" dimension="Height"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="Panel2RightMiddle" dimension="Width"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="Panel2EndMiddle" dimension="Height"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="Panel2Center"/>
				<ColourProperty name="ClientAreaColour"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="withtitle_noframe_client_area">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="2"/>
							</DimOperator>
						</WidgetDim>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
