	<!--
    ***************************************************
        GuiLook/SkillGridItem
        (based on the Taharez Look)
    ***************************************************
    -->
	<WidgetLook name="GuiLook/SkillGridItem">
		<PropertyDefinition name="Image" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="SpecialIcon" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="SpecialIconSub" initialValue="3" redrawOnWrite="true"/>
		<PropertyDefinition name="AnimationImage1" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="AnimationPosX" initialValue="-8" redrawOnWrite="true"/>
		<PropertyDefinition name="AnimationPosY" initialValue="-8" redrawOnWrite="true"/>
		<PropertyDefinition name="AnimationSize" initialValue="60" redrawOnWrite="true"/>
		<PropertyDefinition name="Polygon" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="NumTextColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="BoardWidth" initialValue="1" redrawOnWrite="true"/>
		<PropertyDefinition name="QHLevel" initialValue="" redrawOnWrite="true"/>
		<ImagerySection name="main">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="Image"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="AnimationPosX"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="AnimationPosY"/>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="AnimationSize"/>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="AnimationSize"/>
					</Dim>
				</Area>
				<ImageProperty name="AnimationImage1"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
			<PolygonComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Colour colour="80000000"/>
				<PolygonProperty name="Polygon"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</PolygonComponent>
		</ImagerySection>
		<ImagerySection name="overlay">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="BoardWidth"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="mainUI1" image="selectedUnuse"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="label">
			<TextComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="BoardWidth"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<VertFormat type="BottomAligned"/>
				<HorzFormat type="CentreAligned"/>
			</TextComponent>
		</ImagerySection>
		<ImagerySection name="lock_mark">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="8"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="8"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="8"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="8"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="mainUI1" image="lock"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="lock_mark_over">
