				<VertFormat type="CentreAligned"/>
				<HorzFormat type="CentreAligned"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="main_over">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="-7"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="-7"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Add">
								<AbsoluteDim value="7"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Add">
								<AbsoluteDim value="7"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skins" image="skillSelected"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
