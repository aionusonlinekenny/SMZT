	<!--
    ***************************************************
        GuiLook/NewWindow
    ***************************************************
    -->
	<WidgetLook name="GuiLook/NewWindow">
		<PropertyDefinition name="ClientAreaColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="TitlebarHeight" initialValue="40" redrawOnWrite="true"/>
		<PropertyLinkDefinition name="CaptionColour" widget="__auto_titlebar__" targetProperty="CaptionColour" initialValue="FFc6dee6"/>
		<PropertyLinkDefinition name="TitlebarFont" widget="__auto_titlebar__" targetProperty="Font"/>
		<PropertyLinkDefinition name="GlyphImage" widget="__auto_titlebar__" targetProperty="GlyphImage"/>
		<PropertyDefinition name="BackgroundPictureColour" initialValue="DFFFFFFF" redrawOnWrite="true"/>
		<Property name="AutoRenderingSurface" value="False"/>
		<Property name="RollUpEnabled" value="False"/>
		<Property name="SizingEnabled" value="False"/>
		<Property name="RiseOnClick" value="True"/>
		<NamedArea name="ClientWithTitleWithFrame">
			<Area>
				<Dim type="LeftEdge">
					<ImageDim imageset="skin" image="WindowTopLeft" dimension="Width"/>
				</Dim>
				<Dim type="TopEdge">
					<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="WindowTopRight" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="WindowBottomEdge" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ClientWithTitleNoFrame">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ClientNoTitleWithFrame">
			<Area>
				<Dim type="LeftEdge">
					<ImageDim imageset="skin" image="WindowTopLeft" dimension="Width"/>
				</Dim>
				<Dim type="TopEdge">
					<ImageDim imageset="skin" image="WindowTopEdge" dimension="Height"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="WindowTopRight" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="WindowBottomEdge" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ClientNoTitleNoFrame">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GuiLook/NewTitlebar" nameSuffix="__auto_titlebar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="-3"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge"/>
				</Dim>
				<Dim type="Height">
					<PropertyDim name="TitlebarHeight"/>
				</Dim>
			</Area>
			<Property name="AlwaysOnTop" value="False"/>
		</Child>
		<Child type="GuiLook/CloseButton" nameSuffix="__auto_closebutton__">
			<Area>
				<Dim type="LeftEdge">
					<UnifiedDim scale="1" type="LeftEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="CloseButtonNormal" dimension="Width">
								<DimOperator op="Add">
									<AbsoluteDim value="4"/>
								</DimOperator>
							</ImageDim>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="-2">
						<!--<DimOperator op="Multiply">
							<WidgetDim widget="__auto_titlebar__" dimension="Height">
								<DimOperator op="Subtract">
									<ImageDim imageset="skin" image="CloseButtonNormal" dimension="Height"/>
								</DimOperator>
							</WidgetDim>
						</DimOperator>-->
					</AbsoluteDim>
				</Dim>
				<Dim type="Width">
					<ImageDim imageset="skin" image="CloseButtonNormal" dimension="Width"/>
				</Dim>
				<Dim type="Height">
					<ImageDim imageset="skin" image="CloseButtonNormal" dimension="Height"/>
				</Dim>
			</Area>
			<Property name="AlwaysOnTop" value="True"/>
			<Property name="NormalImage" value="set:skin image:CloseButtonNormal"/>
			<Property name="HoverImage" value="set:skin image:CloseButtonHover"/>
			<Property name="PushedImage" value="set:skin image:CloseButtonPushed"/>
			<Property name="NonClient" value="True"/>
		</Child>
		<Child type="DefaultWindow" nameSuffix="__auto_clickPos__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="-5"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="-3"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<AbsoluteDim value="13"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_titlebar__" dimension="Height">
							</WidgetDim>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
			<Property name="AlwaysOnTop" value="False"/>
			<Property name="MousePassThroughEnabled" value="False"/>
			<Property name="ClippedByParent" value="False"/>
		</Child>
		<ImagerySection name="withtitle_frame">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="2"/>
							</DimOperator>
						</WidgetDim>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Add">
								<AbsoluteDim value="0"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="BottomLeftCorner" imageset="skin" image="WindowBottomLeft"/>
				<Image type="BottomRightCorner" imageset="skin" image="WindowBottomRight"/>
				<Image type="LeftEdge" imageset="skin" image="WindowLeftEdge"/>
				<Image type="RightEdge" imageset="skin" image="WindowRightEdge"/>
				<Image type="BottomEdge" imageset="skin" image="WindowBottomEdge"/>
			</FrameComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<ImageDim imageset="skin" image="WindowTopLeft" dimension="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="0"/>
							</DimOperator>
						</ImageDim>
					</Dim>
					<Dim type="TopEdge">
						<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="2"/>
							</DimOperator>
						</WidgetDim>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="WindowTopRight" dimension="Width">
									<DimOperator op="Subtract">
										<AbsoluteDim value="0"/>
									</DimOperator>
								</ImageDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="WindowBottomEdge" dimension="Height"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="WindowMid"/>
				<ColourProperty name="ClientAreaColour"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="notitle_frame">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="TopLeftCorner" imageset="skin" image="WindowTopLeft"/>
				<Image type="TopRightCorner" imageset="skin" image="WindowTopRight"/>
				<Image type="BottomLeftCorner" imageset="skin" image="WindowBottomLeft"/>
				<Image type="BottomRightCorner" imageset="skin" image="WindowBottomRight"/>
				<Image type="LeftEdge" imageset="skin" image="WindowLeftEdge"/>
				<Image type="RightEdge" imageset="skin" image="WindowRightEdge"/>
				<Image type="BottomEdge" imageset="skin" image="WindowBottomEdge"/>
			</FrameComponent>
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<ImageDim imageset="skin" image="WindowTopLeft" dimension="Width"/>
					</Dim>
					<Dim type="TopEdge">
						<ImageDim imageset="skin" image="WindowTopEdge" dimension="Height"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="WindowTopRight" dimension="Width"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="WindowBottomEdge" dimension="Height"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="WindowMid"/>
				<ColourProperty name="ClientAreaColour"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="withtitle_noframe_client_area">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<WidgetDim widget="__auto_titlebar__" dimension="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="2"/>
							</DimOperator>
						</WidgetDim>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image imageset="skin" image="WindowMid"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="notitle_noframe_client_area"/>
		<StateImagery name="ActiveWithTitleWithFrame">
			<Layer>
				<Section section="withtitle_frame"/>
			</Layer>
		</StateImagery>
		<StateImagery name="InactiveWithTitleWithFrame">
			<Layer>
				<Section section="withtitle_frame"/>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledWithTitleWithFrame">
			<Layer>
				<Section section="withtitle_frame">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="ActiveWithTitleNoFrame">
			<Layer>
				<Section section="withtitle_noframe_client_area"/>
			</Layer>
		</StateImagery>
		<StateImagery name="InactiveWithTitleNoFrame">
			<Layer>
				<Section section="withtitle_noframe_client_area"/>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledWithTitleNoFrame">
			<Layer>
				<Section section="withtitle_noframe_client_area">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="ActiveNoTitleWithFrame">
			<Layer>
				<Section section="notitle_frame"/>
			</Layer>
		</StateImagery>
		<StateImagery name="InactiveNoTitleWithFrame">
			<Layer>
				<Section section="notitle_frame"/>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledNoTitleWithFrame">
			<Layer>
				<Section section="notitle_frame">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="ActiveNoTitleNoFrame">
			<Layer>
				<Section section="notitle_noframe_client_area"/>
			</Layer>
		</StateImagery>
		<StateImagery name="InactiveNoTitleNoFrame">
			<Layer>
				<Section section="notitle_noframe_client_area"/>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledNoTitleNoFrame">
