				<Section section="left">
					<Mono mono="1"/>
				</Section>
				<Section section="center">
					<Mono mono="1"/>
				</Section>
				<Section section="right">
					<Mono mono="1"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/StaticText
    ***************************************************
    -->
	<WidgetLook name="GuiLook/StaticText">
		<PropertyDefinition name="TextColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="DropTextColour" initialValue="FF000000" redrawOnWrite="true"/>
		<PropertyDefinition name="VertFormatting" initialValue="CentreAligned" redrawOnWrite="true"/>
		<PropertyDefinition name="HorzTextFormatting" initialValue="LeftAligned" redrawOnWrite="true"/>
		<Property name="WantsMultiClickEvents" value="False"/>
		<Property name="Font" value="Serif"/>
		<!-- The Imagery sections. This specifies how a section is drawn. -->
		<!-- ************************************************************ -->
		<!-- This section draws the text and that's all. -->
		<ImagerySection name="label">
			<!--<TextComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
						<DimOperator op="Add">
							<AbsoluteDim value="2"/>
						</DimOperator>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
						<DimOperator op="Add">
							<AbsoluteDim value="2"/>
						</DimOperator>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<VertFormatProperty name="VertFormatting"/>
				<HorzFormatProperty name="HorzTextFormatting"/>
				<ColourProperty name="DropTextColour"/>
			</TextComponent>-->
			<TextComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0.2"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="-1.7"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<VertFormatProperty name="VertFormatting"/>
				<HorzFormatProperty name="HorzTextFormatting"/>
				<!--ColourProperty name="TextColour" /-->
			</TextComponent>
		</ImagerySection>
		<!-- The Imagery states. This specifies what sections are drawn in wich state. -->
		<!-- ************************************************************************* -->
		<!-- Enabled -->
		<StateImagery name="Enabled">
			<Layer>
				<Section section="label">
					<ColourProperty name="TextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- Disabled -->
		<StateImagery name="Disabled">
			<Layer>
				<Section section="label">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/TabControl
    ***************************************************
    -->
	<WidgetLook name="GuiLook/TabControl">
		<Property name="TabButtonType" value="GuiLook/TabButton"/>
		<Property name="TabTextPadding" value="{0,12}"/>
		<Property name="TabHeight" value="{0,26}"/>
		<PropertyLinkDefinition name="TabLeft" widget="__auto_TabPane__" targetProperty="TabLeft" initialValue="0"/>
		<PropertyDefinition name="TCScrollLRatio" initialValue="0.2" redrawOnWrite="true"/>
		<PropertyLinkDefinition name="buttonFont" widget="__auto_TabPane__" targetProperty="Font"/>
		<!-- The ratio is height / width -->
		<Child type="GuiLook/TabContentPane" nameSuffix="__auto_TabPane__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="Width"/>
				</Dim>
				<Dim type="TopEdge">
					<PropertyDim widget="__auto_TabPane__" name="EnableBottom">
						<DimOperator op="Multiply">
							<PropertyDim name="TabHeight" type="Height">
								<DimOperator op="Subtract">
									<AbsoluteDim value="3"/>
								</DimOperator>
							</PropertyDim>
						</DimOperator>
					</PropertyDim>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1" type="Height">
						<DimOperator op="Subtract">
							<PropertyDim name="TabHeight" type="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</Child>
		<Child type="GuiLook/TabButtonPane" nameSuffix="__auto_TabPane__Buttons">
			<Area>
				<Dim type="LeftEdge">
					<PropertyDim name="TabHeight" type="Height">
						<DimOperator op="Multiply">
							<PropertyDim name="TCScrollLRatio"/>
						</DimOperator>
					</PropertyDim>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="Width">
						<DimOperator op="Subtract">
							<PropertyDim name="TabHeight" type="Height">
								<DimOperator op="Multiply">
									<PropertyDim name="TCScrollLRatio"/>
								</DimOperator>
							</PropertyDim>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="1">
						<DimOperator op="Add">
							<PropertyDim widget="__auto_TabPane__Buttons" name="EnableTop">
								<DimOperator op="Multiply">
									<UnifiedDim scale="1" type="Height">
										<DimOperator op="Subtract">
											<PropertyDim name="TabHeight" type="Height"/>
										</DimOperator>
									</UnifiedDim>
								</DimOperator>
							</PropertyDim>
						</DimOperator>
					</AbsoluteDim>
				</Dim>
				<Dim type="Height">
					<PropertyDim name="TabHeight" type="Height"/>
				</Dim>
			</Area>
		</Child>
		<Child type="GlossySerpent/GlyphButton" nameSuffix="__auto_TabPane__ScrollLeft">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<WidgetDim widget="__auto_TabPane__Buttons" dimension="TopEdge"/>
				</Dim>
				<Dim type="Width">
					<WidgetDim widget="__auto_TabPane__Buttons" dimension="Height">
						<DimOperator op="Multiply">
							<PropertyDim name="TCScrollLRatio"/>
						</DimOperator>
					</WidgetDim>
				</Dim>
				<Dim type="BottomEdge">
					<WidgetDim widget="__auto_TabPane__Buttons" dimension="BottomEdge"/>
				</Dim>
			</Area>
			<Property name="AlwaysOnTop" value="True"/>
			<Property name="GlyphImage" value="set:skin image:LastBtnNormal"/>
		</Child>
		<Child type="GlossySerpent/GlyphButton" nameSuffix="__auto_TabPane__ScrollRight">
			<Area>
				<Dim type="Width">
					<WidgetDim widget="__auto_TabPane__Buttons" dimension="Height">
						<DimOperator op="Multiply">
							<PropertyDim name="TCScrollLRatio"/>
						</DimOperator>
					</WidgetDim>
				</Dim>
				<Dim type="LeftEdge">
					<UnifiedDim scale="1" type="Width">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_TabPane__ScrollRight" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="TopEdge">
					<WidgetDim widget="__auto_TabPane__Buttons" dimension="TopEdge"/>
				</Dim>
				<Dim type="Height">
					<WidgetDim widget="__auto_TabPane__Buttons" dimension="Height"/>
				</Dim>
			</Area>
			<Property name="AlwaysOnTop" value="True"/>
			<Property name="GlyphImage" value="set:skin image:NextBtnNormal"/>
		</Child>
		<StateImagery name="Enabled"/>
		<StateImagery name="Disabled"/>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/TabButton
    ***************************************************
    -->
	<WidgetLook name="GuiLook/TabButton">
		<PropertyDefinition name="NormalTextColour" initialValue="ff65b3e9" redrawOnWrite="true"/>
		<PropertyDefinition name="HoverTextColour" initialValue="ff7de8ff" redrawOnWrite="true"/>
		<PropertyDefinition name="PushedTextColour" initialValue="ffc6dee6" redrawOnWrite="true"/>
		<PropertyDefinition name="SelectedTextColour" initialValue="ffc6dee6" redrawOnWrite="true"/>
		<PropertyDefinition name="DisabledTextColour" initialValue="ffaaaaaa" redrawOnWrite="true"/>
		<PropertyDefinition name="GlyphImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="GlyphWidth" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="GlyphOffsetX" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="VertImageFormatting" initialValue="BottomAligned" redrawOnWrite="true"/>
		<PropertyDefinition name="HorzImageFormatting" initialValue="LeftAligned" redrawOnWrite="true"/>
		<PropertyDefinition name="TBFont" initialValue="songti_14_strengh" redrawOnWrite="true"/>
		<ImagerySection name="glyph">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="GlyphOffsetX"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<ImageProperty name="GlyphImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="label">
			<TextComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="GlyphWidth">
							<DimOperator op="Add">
								<PropertyDim name="GlyphOffsetX"/>
							</DimOperator>
						</PropertyDim>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<FontProperty name="TBFont"/>
				<VertFormat type="CentreAligned"/>
				<HorzFormat type="CentreAligned"/>
			</TextComponent>
		</ImagerySection>
		<ImagerySection name="normal">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="LeftEdge" imageset="skin" image="tabLeftNormal"/>
				<Image type="RightEdge" imageset="skin" image="tabRightNormal"/>
				<Image type="Background" imageset="skin" image="tabMiddleNormal"/>
			</FrameComponent>
		</ImagerySection>
		<ImagerySection name="hover">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="LeftEdge" imageset="skin" image="tabLeftHover"/>
				<Image type="RightEdge" imageset="skin" image="tabRightHover"/>
				<Image type="Background" imageset="skin" image="tabMiddleHover"/>
			</FrameComponent>
		</ImagerySection>
		<ImagerySection name="pushed">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="LeftEdge" imageset="skin" image="tabLeftPushed"/>
				<Image type="RightEdge" imageset="skin" image="tabRightPushed"/>
				<Image type="Background" imageset="skin" image="tabMiddlePushed"/>
			</FrameComponent>
		</ImagerySection>
		<ImagerySection name="disabled">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge"/>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge"/>
					</Dim>
				</Area>
				<Image type="LeftEdge" imageset="skin" image="tabLeftDisable"/>
				<Image type="RightEdge" imageset="skin" image="tabRightDisable"/>
				<Image type="Background" imageset="skin" image="tabMiddleDisable"/>
			</FrameComponent>
		</ImagerySection>
		<StateImagery name="TopNormal">
			<Layer>
				<Section section="normal"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="NormalTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="BottomNormal">
			<Layer>
				<Section section="normal"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="NormalTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="TopHover">
			<Layer>
				<Section section="hover"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="HoverTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="BottomHover">
			<Layer>
				<Section section="hover"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="HoverTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="TopSelected">
			<Layer>
				<Section section="pushed"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="SelectedTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="BottomSelected">
			<Layer>
				<Section section="pushed"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="SelectedTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="TopPushed">
			<Layer>
				<Section section="pushed"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="PushedTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="BottomPushed">
			<Layer>
				<Section section="pushed"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="PushedTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="TopDisabled">
			<Layer>
				<Section section="disabled"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="BottomDisabled">
			<Layer>
				<Section section="disabled"/>
				<Section section="glyph"/>
				<Section section="label">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/TabContentPane
    ***************************************************
    -->
	<WidgetLook name="GuiLook/TabContentPane">
		<PropertyDefinition name="TabLeft" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="EnableTop" initialValue="1" redrawOnWrite="true" layoutOnWrite="true"/>
		<PropertyDefinition name="EnableBottom" initialValue="1" redrawOnWrite="true" layoutOnWrite="true"/>
		<ImagerySection name="normal">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="TabLeft"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<!--<Image type="TopLeftCorner" imageset="tj2common" image="Panel2TopLeft"/>
				<Image type="TopRightCorner" imageset="tj2common" image="Panel2TopRight"/>
				<Image type="BottomLeftCorner" imageset="tj2common" image="Panel2BottomLeft"/>
				<Image type="BottomRightCorner" imageset="tj2common" image="Panel2BottomRight"/>
				<Image type="LeftEdge" imageset="tj2common" image="Panel2Left"/>
				<Image type="TopEdge" imageset="tj2common" image="Panel2Top"/>
				<Image type="RightEdge" imageset="tj2common" image="Panel2Right"/>
				<Image type="BottomEdge" imageset="tj2common" image="Panel2Bottom"/>
				<Image type="Background" imageset="tj2common" image="Panel2Center"/>-->
			</FrameComponent>
		</ImagerySection>
		<StateImagery name="Enabled">
			<Layer>
				<Section section="normal"/>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="normal">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/TabButtonPane
    ***************************************************
    -->
	<WidgetLook name="GuiLook/TabButtonPane">
		<PropertyDefinition name="EnableTop" initialValue="1" redrawOnWrite="true" layoutOnWrite="true"/>
		<PropertyDefinition name="EnableBottom" initialValue="1" redrawOnWrite="true" layoutOnWrite="true"/>
		<ImagerySection name="normal">

        </ImagerySection>
		<StateImagery name="Enabled">
			<Layer>
				<Section section="normal"/>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="normal">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GlossySerpent/GlyphButton
        (based on the Taharez Look)
    ***************************************************
    -->
	<WidgetLook name="GlossySerpent/GlyphButton">
		<PropertyDefinition name="GlyphImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="VertImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="HorzImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_DarkerThemeColour" initialValue="FF940000" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_LighterThemeColour" initialValue="FFFF0101" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_MainThemeColour" initialValue="FFDC5F5F" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_ShineColour" initialValue="B0FFFFFF" redrawOnWrite="true"/>
		<ImagerySection name="glyph">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<ImageDim imageset="skin" image="CommonBg4LeftTop" dimension="Width"/>
					</Dim>
					<Dim type="TopEdge">
						<ImageDim imageset="skin" image="CommonBg4TopMiddle" dimension="Height"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="CommonBg4RightMiddle" dimension="Width"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<ImageDim imageset="skin" image="CommonBg4EndMiddle" dimension="Height"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="GlyphImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<StateImagery name="Normal">
			<Layer>
				<Section look="GuiLook/StaticShared" section="itemframe"/>
				<!--GuiLook/StaticShared 没找到  可能官方的-->
				<Section section="glyph">
					<ColourProperty name="GS_MainThemeColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="Hover">
			<Layer>
				<Section look="GuiLook/StaticShared" section="itemframe"/>
				<Section section="glyph">
					<ColourProperty name="GS_LighterThemeColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="Pushed">
			<Layer>
				<Section look="GuiLook/StaticShared" section="itemframe"/>
				<Section section="glyph">
					<ColourProperty name="GS_DarkerThemeColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="PushedOff">
			<Layer>
				<Section look="GuiLook/StaticShared" section="itemframe"/>
				<Section section="glyph">
					<ColourProperty name="GS_LighterThemeColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section look="GuiLook/StaticShared" section="itemframe"/>
				<Section section="glyph">
					<Colour colour="997F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/DataGrid
    ***************************************************
    -->
	<WidgetLook name="GuiLook/DataGrid">
		<!-- The size of the scrollbar + buttons -->
		<PropertyDefinition name="ScrollBarPreferredSize" initialValue="20" redrawOnWrite="true" layoutOnWrite="false"/>
		<NamedArea name="ItemRenderingArea">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge">
						<DimOperator op="Subtract">
							<AbsoluteDim value="0"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<AbsoluteDim value="0"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaHScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge">
						<DimOperator op="Subtract">
							<AbsoluteDim value="0"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_hscrollbar__" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaVScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_vscrollbar__" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<AbsoluteDim value="0"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaHVScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_vscrollbar__" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_hscrollbar__" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GuiLook/HorizontalScrollbar" nameSuffix="__auto_hscrollbar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<UnifiedDim scale="1.0" type="Width"/>
				</Dim>
				<Dim type="Height">
					<PropertyDim name="ScrollBarPreferredSize"/>
				</Dim>
			</Area>
			<VertAlignment type="BottomAligned"/>
		</Child>
		<Child type="GuiLook/VerticalScrollbar" nameSuffix="__auto_vscrollbar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<PropertyDim name="ScrollBarPreferredSize"/>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1.0" type="Height"/>
				</Dim>
			</Area>
			<HorzAlignment type="RightAligned"/>
		</Child>
		<StateImagery name="Enabled"/>
		<StateImagery name="Disabled"/>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/HorizontalScrollbar
    ***************************************************
    -->
	<WidgetLook name="GuiLook/HorizontalScrollbar">
		<!-- WARNING: this property link seems to be problematic for the cegui layout editor. Tested with ceed_07. TODO: retest 
        <PropertyLinkDefinition name="ThumbMinSize" widget="__auto_thumb__" targetProperty="UnifiedMinSize" initialValue="{{0,25},{0,0}}" />-->
		<NamedArea name="ThumbTrackArea">
			<Area>
				<!-- Assume square form of buttons; resize edges (left & right) accordingly -->
				<Dim type="LeftEdge">
					<UnifiedDim scale="1.0" type="Height"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge">
						<DimOperator op="Subtract">
							<UnifiedDim scale="1.0" type="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GlossySerpent/GlyphButton" nameSuffix="__auto_incbtn__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<UnifiedDim scale="1" type="Height"/>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1" type="Height"/>
				</Dim>
			</Area>
			<HorzAlignment type="RightAligned"/>
			<Property name="GlyphImage" value="set:skin image:NextBtnNormal"/>
		</Child>
		<Child type="GlossySerpent/GlyphButton" nameSuffix="__auto_decbtn__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<UnifiedDim scale="1" type="Height"/>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1" type="Height"/>
				</Dim>
			</Area>
			<Property name="GlyphImage" value="set:skin image:LastBtnNormal"/>
		</Child>
		<Child type="GuiLook/HorizontalScrollbarThumb" nameSuffix="__auto_thumb__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<UnifiedDim scale="0.1" type="Width"/>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1" type="Height"/>
				</Dim>
			</Area>
			<Property name="UnifiedMinSize" value="{{0,25},{0,0}}"/>
		</Child>
		<ImagerySection name="main">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<UnifiedDim scale="0.0" type="LeftEdge">
							<DimOperator op="Add">
								<UnifiedDim scale="1" type="Height"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1.0" type="RightEdge">
							<DimOperator op="Subtract">
								<UnifiedDim scale="1" type="Height"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1.0" type="BottomEdge"/>
					</Dim>
				</Area>
				<!--<Image imageset="tj2special1" image="ChatBtnNormal"/>-->
				<VertFormat type="CentreAligned"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<StateImagery name="Enabled">
			<Layer>
				<Section section="main"/>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="main">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
