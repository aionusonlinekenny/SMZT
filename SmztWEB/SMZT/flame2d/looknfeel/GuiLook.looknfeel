					</Dim>
				</Area>
				<ImageProperty name="AnimationImage1"/>
				<VertFormat type="CentreAligned"/>
				<HorzFormat type="CentreAligned"/>
			</ImageryComponent>
			<PolygonComponent>
				<Area>
					<Dim type="LeftEdge">
