    -->
	<WidgetLook name="GuiLook/StaticTextBox">
		<Property name="TextColours" value="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="FrameColours" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="BackgroundColours" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<Property name="FrameEnabled" value="True" redrawOnWrite="true"/>
		<Property name="BackgroundEnabled" value="True" redrawOnWrite="true"/>
		<Property name="VertFormatting" value="Stretched" redrawOnWrite="true"/>
		<Property name="HorzFormatting" value="WordWrapLeftAligned" redrawOnWrite="true"/>
