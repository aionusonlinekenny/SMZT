	<!--
    ***************************************************
        #GuiLook/StaticShared  wxz
        (Shared imagery components for static widgets)
    ***************************************************
    -->
	<WidgetLook name="GuiLook/StaticShared">
	<!--GuiLook/ButtonFilter的样式-->
		<ImagerySection name="buttonFilter">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<Image type="TopLeftCorner" imageset="skins" image="LeftTop"/>
				<Image type="TopRightCorner" imageset="skins" image="RightTop"/>
				<Image type="BottomLeftCorner" imageset="skins" image="LeftEnd"/>
				<Image type="BottomRightCorner" imageset="skins" image="RightEnd"/>
				<Image type="LeftEdge" imageset="skins" image="LeftMiddle"/>
				<Image type="RightEdge" imageset="skins" image="RightMiddle"/>
				<Image type="TopEdge" imageset="skins" image="TopMiddle"/>
				<Image type="BottomEdge" imageset="skins" image="EndMiddle"/>
				<Image type="Background" imageset="skins" image="center"/>
			</FrameComponent>
		</ImagerySection>
		<ImagerySection name="frame">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<Image type="TopLeftCorner" imageset="skin" image="StaticTopLeft"/>
				<Image type="TopRightCorner" imageset="skin" image="StaticTopRight"/>
				<Image type="BottomLeftCorner" imageset="skin" image="StaticBottomLeft"/>
				<Image type="BottomRightCorner" imageset="skin" image="StaticBottomRight"/>
				<Image type="LeftEdge" imageset="skin" image="StaticLeft"/>
