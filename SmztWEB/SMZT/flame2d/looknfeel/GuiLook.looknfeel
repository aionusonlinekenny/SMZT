	<WidgetLook name="GuiLook/ComboDropList">
		<NamedArea name="ItemRenderingArea">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="inputBgRightMiddle" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="inputBgEndMiddle" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaHScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="inputBgRightMiddle" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_hscrollbar__" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaVScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_vscrollbar__" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="inputBgEndMiddle" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaHVScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_vscrollbar__" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_hscrollbar__" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GuiLook/HorizontalScrollbar" nameSuffix="__auto_hscrollbar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="Width">
					<UnifiedDim scale="1" offset="-16" type="Width"/>
				</Dim>
				<Dim type="Height">
					<AbsoluteDim value="16"/>
				</Dim>
			</Area>
			<VertAlignment type="BottomAligned"/>
		</Child>
		<Child type="GuiLook/VerticalScrollbar" nameSuffix="__auto_vscrollbar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="-1"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="3"/>
				</Dim>
				<Dim type="Width">
					<AbsoluteDim value="20"/>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1" offset="-6" type="Height"/>
				</Dim>
			</Area>
			<HorzAlignment type="RightAligned"/>
		</Child>
		<StateImagery name="Enabled">
			<Layer>
				<Section look="GuiLook/StaticShared" section="inputBg"/>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="main">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GlossySerpent/GlyphButtonCombo by 王晓晔
        (based on the Taharez Look)
    ***************************************************
    -->
	<WidgetLook name="GlossySerpent/GlyphButtonCombo">
		<PropertyDefinition name="NormalImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="HoverImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="PushedImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="GlyphImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="VertImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="HorzImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_DarkerThemeColour" initialValue="FF940000" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_LighterThemeColour" initialValue="FFFF0101" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_MainThemeColour" initialValue="FFDC5F5F" redrawOnWrite="true"/>
		<PropertyDefinition name="GS_ShineColour" initialValue="B0FFFFFF" redrawOnWrite="true"/>
		<ImagerySection name="glyph">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<ImageProperty name="GlyphImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="background_section">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="inputBgCenter"/>
				<!-- shared image from other item -->
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="background_normal">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="dropDownNormal"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="background_hover">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="dropDownHover"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="background_pushed">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="3"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<AbsoluteDim value="3"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<Image imageset="skin" image="dropDownPushed"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<StateImagery name="Normal">
			<Layer>
				<Section section="background_section">
					<ColourProperty name="GS_MainThemeColour"/>
				</Section>
			</Layer>
			<Layer>
				<Section section="background_normal">
					<ColourProperty name="GS_ShineColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="Hover">
			<Layer>
				<Section section="background_section">
					<ColourProperty name="GS_LighterThemeColour"/>
				</Section>
			</Layer>
			<Layer>
				<Section section="background_hover">
					<ColourProperty name="GS_ShineColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="Pushed">
			<Layer>
				<Section section="background_section">
					<ColourProperty name="GS_DarkerThemeColour"/>
				</Section>
			</Layer>
			<Layer>
				<Section section="background_pushed">
					<ColourProperty name="GS_ShineColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="PushedOff">
			<Layer>
				<Section section="background_section">
					<ColourProperty name="GS_LighterThemeColour"/>
				</Section>
			</Layer>
			<Layer>
				<Section section="background_normal">
					<ColourProperty name="GS_ShineColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="background_section">
					<ColourProperty name="GS_MainThemeColour"/>
					<Colour colour="997F7F7F"/>
				</Section>
			</Layer>
			<Layer>
				<Section section="background_normal">
					<ColourProperty name="GS_ShineColour"/>
					<Colour colour="997F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/Listbox   by 王晓晔
    ***************************************************
    -->
	<WidgetLook name="GuiLook/Listbox">
		<!-- The size of the scrollbar + buttons -->
		<PropertyDefinition name="ScrollBarPreferredSize" initialValue="15" redrawOnWrite="true" layoutOnWrite="false"/>
		<NamedArea name="ItemRenderingArea">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaBack">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaHScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_hscrollbar__" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaVScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_vscrollbar__" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaHVScroll">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_vscrollbar__" dimension="Width"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_hscrollbar__" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaLVScroll">
			<Area>
				<Dim type="LeftEdge">
					<WidgetDim widget="__auto_vscrollbar__" dimension="Width">
						<DimOperator op="Add">
							<AbsoluteDim value="0"/>
						</DimOperator>
					</WidgetDim>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge"/>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="ItemRenderingAreaHLVScroll">
			<Area>
				<Dim type="LeftEdge">
					<WidgetDim widget="__auto_vscrollbar__" dimension="Width">
						<DimOperator op="Add">
							<AbsoluteDim value="2"/>
						</DimOperator>
					</WidgetDim>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<WidgetDim widget="__auto_hscrollbar__" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GuiLook/HorizontalScrollbar" nameSuffix="__auto_hscrollbar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<UnifiedDim scale="1.0" type="Width"/>
				</Dim>
				<Dim type="Height">
					<PropertyDim name="ScrollBarPreferredSize"/>
				</Dim>
			</Area>
			<VertAlignment type="BottomAligned"/>
		</Child>
		<Child type="GuiLook/MainVerticalScrollbar" nameSuffix="__auto_vscrollbar__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<PropertyDim name="ScrollBarPreferredSize"/>
				</Dim>
				<Dim type="Height">
					<UnifiedDim scale="1.0" type="Height"/>
				</Dim>
			</Area>
			<HorzAlignment type="RightAligned"/>
		</Child>
		<StateImagery name="Enabled">
        </StateImagery>
		<StateImagery name="Disabled">
        </StateImagery>
		<StateImagery name="BackEnabled">
			<Layer>
				<Section look="GuiLook/StaticShared" section="common_panel2"/>
			</Layer>
		</StateImagery>
		<StateImagery name="BackDisabled">
			<Layer>
				<Section look="GuiLook/StaticShared" section="common_panel1">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GlossySerpent/NineStretchImage by 韩孟轲
    ***************************************************
    -->
	<WidgetLook name="GlossySerpent/NineStretchImage">
		<PropertyDefinition name="TopLeftImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="TopRightImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="BottomLeftImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="BottomRightImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="LeftImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="RightImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="TopImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="BottomImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="CenterImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="LeftOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="RightOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="TopOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="BottomOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="VertImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="HorzImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<ImagerySection name="topLeft">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="TopOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="TopLeftImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="bottomLeft">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="BottomOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="BottomOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="BottomLeftImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="topRight">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="RightOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="RightOffset"/>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="TopOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="TopRightImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="bottomRight">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="RightOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="TopEdge">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="BottomOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="RightOffset"/>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="BottomOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="BottomRightImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="left">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="TopOffset"/>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="TopOffset">
									<DimOperator op="Add">
										<PropertyDim name="BottomOffset"/>
									</DimOperator>
								</PropertyDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="LeftImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="center">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="TopOffset"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="LeftOffset">
									<DimOperator op="Add">
										<PropertyDim name="RightOffset"/>
									</DimOperator>
								</PropertyDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="TopOffset">
									<DimOperator op="Add">
										<PropertyDim name="BottomOffset"/>
									</DimOperator>
								</PropertyDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="CenterImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="right">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="RightOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="TopEdge">
						<PropertyDim name="TopOffset"/>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="RightOffset"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="TopOffset">
									<DimOperator op="Add">
										<PropertyDim name="BottomOffset"/>
									</DimOperator>
								</PropertyDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<ImageProperty name="RightImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="top">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="LeftOffset">
									<DimOperator op="Add">
										<PropertyDim name="RightOffset"/>
									</DimOperator>
								</PropertyDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="TopOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="TopImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="bottom">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="TopEdge">
						<UnifiedDim scale="1" type="Height">
							<DimOperator op="Subtract">
								<PropertyDim name="BottomOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="LeftOffset">
									<DimOperator op="Add">
										<PropertyDim name="RightOffset"/>
									</DimOperator>
								</PropertyDim>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<PropertyDim name="BottomOffset"/>
					</Dim>
				</Area>
				<ImageProperty name="BottomImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<StateImagery name="Enabled">
			<Layer>
				<Section section="center"/>
				<Section section="left"/>
				<Section section="right"/>
				<Section section="top"/>
				<Section section="topLeft"/>
				<Section section="topRight"/>
				<Section section="bottom"/>
				<Section section="bottomLeft"/>
				<Section section="bottomRight"/>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="left">
					<Mono mono="1"/>
				</Section>
				<Section section="center">
					<Mono mono="1"/>
				</Section>
				<Section section="right">
					<Mono mono="1"/>
				</Section>
				<Section section="top">
					<Mono mono="1"/>
				</Section>
				<Section section="bottom">
					<Mono mono="1"/>
				</Section>
				<Section section="topLeft">
					<Mono mono="1"/>
				</Section>
				<Section section="topRight">
					<Mono mono="1"/>
				</Section>
				<Section section="bottomLeft">
					<Mono mono="1"/>
				</Section>
				<Section section="bottomRight">
					<Mono mono="1"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--    ******************************************************************************************************        
												   盈娱     WXZ
	*************************************************** ***************************************************    -->
	<!--
    ***************************************************
        GuiLook/ThreeStretchImageButton
    ***************************************************
    -->
	<WidgetLook name="GuiLook/ThreeStretchImageButton">
		<PropertyDefinition name="LeftImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="CenterImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="RightImage" initialValue="" redrawOnWrite="true"/>
		<PropertyDefinition name="LeftOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="RightOffset" initialValue="0" redrawOnWrite="true"/>
		<PropertyDefinition name="VertImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="HorzImageFormatting" initialValue="Stretched" redrawOnWrite="true"/>
		<PropertyDefinition name="onClick" initialValue="" layoutOnWrite="true"/>
		<PropertyDefinition name="NormalImageColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="HoverImageColour" initialValue="FF151515" redrawOnWrite="true"/>
		<PropertyDefinition name="PushedImageColour" initialValue="FF7F7F7F" redrawOnWrite="true"/>
		<PropertyDefinition name="NormalTextColour" initialValue="FFfcd78a" redrawOnWrite="true"/>
		<PropertyDefinition name="HoverTextColour" initialValue="FFFFFF00" redrawOnWrite="true"/>
		<PropertyDefinition name="PushedTextColour" initialValue="FF8080ff" redrawOnWrite="true"/>
		<PropertyDefinition name="DisabledTextColour" initialValue="FF7F7F7F" redrawOnWrite="true"/>
		<PropertyDefinition name="VertLabelFormatting" initialValue="CentreAligned"/>
		<PropertyDefinition name="HorzLabelFormatting" initialValue="CentreAligned"/>
		<ImagerySection name="label">
			<TextComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<VertFormatProperty name="VertLabelFormatting"/>
				<HorzFormatProperty name="HorzLabelFormatting"/>
			</TextComponent>
		</ImagerySection>
		<ImagerySection name="left">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<ImageProperty name="LeftImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="center">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<PropertyDim name="LeftOffset"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="RightOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<ImageProperty name="CenterImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
				<HorzFormatProperty name="HorzImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="right">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<PropertyDim name="RightOffset"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<ImageProperty name="RightImage"/>
				<VertFormatProperty name="VertImageFormatting"/>
			</ImageryComponent>
		</ImagerySection>
		<!-- regular representation of the button -->
		<StateImagery name="Normal">
			<Layer>
				<Section section="left"/>
				<Section section="center"/>
				<Section section="right"/>
				<Section section="label">
					<ColourProperty name="NormalTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- the cursor is hovering over the button -->
		<StateImagery name="Hover">
			<Layer>
				<Section section="left">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
				<Section section="center">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
				<Section section="right">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
				<Section section="label">
					<ColourProperty name="HoverTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- the cursor is pushing the button -->
		<StateImagery name="Pushed">
			<Layer>
				<Section section="left">
					<ColourProperty name="PushedImageColour"/>
				</Section>
				<Section section="center">
					<ColourProperty name="PushedImageColour"/>
				</Section>
				<Section section="right">
					<ColourProperty name="PushedImageColour"/>
				</Section>
				<Section section="label">
					<ColourProperty name="PushedTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- the cursor pushed the buton, but is moving away -->
		<StateImagery name="PushedOff">
			<Layer>
				<Section section="left">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
				<Section section="center">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
				<Section section="right">
					<ColourProperty name="NormalImageColour"/>
					<ColourOffsetProperty name="HoverImageColour"/>
				</Section>
				<Section section="label">
					<ColourProperty name="HoverTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<!-- the button is simply disabled -->
		<StateImagery name="Disabled">
			<Layer>
				<Section section="left">
					<Mono mono="1"/>
				</Section>
				<Section section="center">
					<Mono mono="1"/>
				</Section>
				<Section section="right">
					<Mono mono="1"/>
				</Section>
				<Section section="label">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
