	<!--
    ***************************************************
        GuiLook/RedVerticalScrollbar
    ***************************************************
    -->
	<WidgetLook name="GuiLook/RedVerticalScrollbar">
		<!-- WARNING: this property link seems to be problematic for the cegui layout editor. Tested with ceed_07. TODO: retest -->
		<PropertyDefinition name="ThumbSize" initialValue="23"/>
		<Property name="VerticalScrollbar" value="True"/>
		<NamedArea name="ThumbTrackArea">
			<Area>
				<!-- Assume square form of buttons; resize edges (top & bottom) accordingly -->
				<Dim type="LeftEdge">
					<AbsoluteDim value="1"/>
				</Dim>
				<Dim type="TopEdge">
					<ImageDim imageset="skin" image="DownNormal" dimension="Height"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1.0" type="RightEdge"/>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1.0" type="BottomEdge">
						<DimOperator op="Subtract">
							<ImageDim imageset="skin" image="UpPushed" dimension="Height"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<Child type="GuiLook/ImageButton" nameSuffix="__auto_incbtn__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="2"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<AbsoluteDim value="15"/>
				</Dim>
				<!--<ImageDim imageset="skin" image="VertScrollBarDownNormal" dimension="Width"/>-->
				<Dim type="Height">
					<ImageDim imageset="skin" image="DownNormal" dimension="Height"/>
				</Dim>
			</Area>
			<VertAlignment type="BottomAligned"/>
			<Property name="HoverImage" value="set:skin image:DownHover"/>
			<Property name="NormalImage" value="set:skin image:DownNormal"/>
			<Property name="PushedImage" value="set:skin image:DownPushed"/>
			<Property name="DisabledImage" value="set:skin image:DownNormal"/>
		</Child>
		<Child type="GuiLook/ImageButton" nameSuffix="__auto_decbtn__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="2"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<AbsoluteDim value="15"/>
				</Dim>
				<!--<ImageDim imageset="skin" image="VertScrollBarUpHover" dimension="Width"/>-->
				<Dim type="Height">
					<ImageDim imageset="skin" image="UpHover" dimension="Height"/>
				</Dim>
			</Area>
			<Property name="HoverImage" value="set:skin image:UpHover"/>
			<Property name="NormalImage" value="set:skin image:UpNormal"/>
			<Property name="PushedImage" value="set:skin image:UpPushed"/>
			<Property name="DisabledImage" value="set:skin image:UpNormal"/>
		</Child>
		<Child type="GuiLook/VerticalScrollbarThumb" nameSuffix="__auto_thumb__">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="2"/>
				</Dim>
				<Dim type="TopEdge">
					<ImageDim imageset="skin" image="DownNormal" dimension="Height"/>
				</Dim>
				<Dim type="Width">
					<AbsoluteDim value="17"/>
					<!--<ImageDim imageset="skin" image="VertScrollBarDownNormal" dimension="Width"/>-->
				</Dim>
				<Dim type="Height">
					<PropertyDim name="ThumbSize"/>
				</Dim>
			</Area>
			<Property name="VertFree" value="True"/>
			<Property name="TopImage" value="set:skin image:VertScrollBarThumbTopRed"/>
			<Property name="BottomImage" value="set:skin image:VertScrollBarThumbBottomRed"/>
			<Property name="CenterImage" value="set:skin image:VertScrollBarThumbCenterRed"/>
			<!--<Property name="MarkImage" value="set:tj2common image:VertScrollBarThumbMark" />
			<Property name="MarkImageHalfHeight" value="6.5" />-->
			<!-- 3 5-->
			<Property name="TopOffset" value="3"/>
			<Property name="BottomOffset" value="5"/>
		</Child>
		<ImagerySection name="main">
			<FrameComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<ImageDim imageset="skin" image="VertScrollBarBackGroundCenterRed" dimension="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<Image type="TopEdge" imageset="skin" image="VertScrollBarBackGroundTopRed"/>
				<Image type="BottomEdge" imageset="skin" image="VertScrollBarBackGroundBottomRed"/>
				<Image type="Background" imageset="skin" image="VertScrollBarBackGroundCenterRed"/>
				<!--VertFormat type="Stretched" /-->
				<!--HorzFormat type="CentreAligned" /-->
			</FrameComponent>
		</ImagerySection>
		<StateImagery name="Enabled">
			<Layer>
				<Section section="main"/>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section section="main">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/PopupMenu wxz
    ***************************************************
    -->
	<WidgetLook name="GuiLook/PopupMenu">
		<PropertyDefinition name="BackgroundColours" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="BorderWidth" initialValue="5" layoutOnWrite="true"/>
		<PropertyDefinition name="BorderHeight" initialValue="10" layoutOnWrite="true"/>
		<NamedArea name="ItemRenderArea">
			<Area>
				<Dim type="LeftEdge">
					<PropertyDim name="BorderWidth"/>
				</Dim>
				<Dim type="TopEdge">
					<PropertyDim name="BorderHeight"/>
				</Dim>
				<Dim type="RightEdge">
					<UnifiedDim scale="1" type="RightEdge">
						<DimOperator op="Subtract">
							<PropertyDim name="BorderWidth"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
				<Dim type="BottomEdge">
					<UnifiedDim scale="1" type="BottomEdge">
						<DimOperator op="Subtract">
							<PropertyDim name="BorderHeight"/>
						</DimOperator>
					</UnifiedDim>
				</Dim>
			</Area>
		</NamedArea>
		<StateImagery name="Enabled">
			<Layer>
				<Section look="GuiLook/StaticShared" section="commonBG4">
					<ColourProperty name="BackgroundColours"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="Disabled">
			<Layer>
				<Section look="GuiLook/StaticShared" section="commonBG4">
					<Colour colour="FF7F7F7F"/>
				</Section>
			</Layer>
		</StateImagery>
	</WidgetLook>
	<!--
    ***************************************************
        GuiLook/MenuItem wxz
    ***************************************************
    -->
	<WidgetLook name="GuiLook/MenuItem">
		<PropertyDefinition name="NormalTextColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="DisabledTextColour" initialValue="FF7F7F7F" redrawOnWrite="true"/>
		<PropertyDefinition name="HoverColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<PropertyDefinition name="PushedColour" initialValue="FFFFFF00" redrawOnWrite="true"/>
		<PropertyDefinition name="OpenedColour" initialValue="FFFFFFFF" redrawOnWrite="true"/>
		<Property name="WantsMultiClickEvents" value="False"/>
		<NamedArea name="ContentSize">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<FontDim type="HorzExtent">
						<DimOperator op="Add">
							<AbsoluteDim value="8"/>
						</DimOperator>
					</FontDim>
				</Dim>
				<Dim type="Height">
					<FontDim type="LineSpacing">
						<DimOperator op="Add">
							<AbsoluteDim value="8"/>
						</DimOperator>
					</FontDim>
				</Dim>
			</Area>
		</NamedArea>
		<NamedArea name="HasPopupContentSize">
			<Area>
				<Dim type="LeftEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="TopEdge">
					<AbsoluteDim value="0"/>
				</Dim>
				<Dim type="Width">
					<FontDim type="HorzExtent">
						<DimOperator op="Add">
							<AbsoluteDim value="10"/>
						</DimOperator>
					</FontDim>
				</Dim>
				<Dim type="Height">
					<FontDim type="LineSpacing">
						<DimOperator op="Add">
							<AbsoluteDim value="5"/>
						</DimOperator>
					</FontDim>
				</Dim>
			</Area>
		</NamedArea>
		<ImagerySection name="label">
			<TextComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="10"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="RightEdge">
						<UnifiedDim scale="1" type="RightEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="10"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="BottomEdge">
						<UnifiedDim scale="1" type="BottomEdge">
							<DimOperator op="Subtract">
								<AbsoluteDim value="0"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
				</Area>
				<VertFormat type="CentreAligned"/>
				<HorzFormat type="LeftAligned"/>
			</TextComponent>
		</ImagerySection>
		<ImagerySection name="frame">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<!-- tj2special MenuHoverLeft menuSelBG-->
				<Image imageset="skin" image="menuOverBG"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="pushframe">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width"/>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<Image imageset="skin" image="menuSelBG"/>
				<VertFormat type="Stretched"/>
				<HorzFormat type="Stretched"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="popup_arrow_right">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="10"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<!--Image imageset="GuiLook" image="PopupMenuArrowRight" /-->
				<VertFormat type="CentreAligned"/>
				<HorzFormat type="RightAligned"/>
			</ImageryComponent>
		</ImagerySection>
		<ImagerySection name="popup_arrow_left">
			<ImageryComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="Width">
						<UnifiedDim scale="1" type="Width">
							<DimOperator op="Subtract">
								<AbsoluteDim value="10"/>
							</DimOperator>
						</UnifiedDim>
					</Dim>
					<Dim type="Height">
						<UnifiedDim scale="1" type="Height"/>
					</Dim>
				</Area>
				<!--Image imageset="GuiLook" image="PopupMenuArrowLeft" /-->
				<VertFormat type="CentreAligned"/>
				<HorzFormat type="RightAligned"/>
			</ImageryComponent>
		</ImagerySection>
		<StateImagery name="EnabledNormal">
			<Layer>
				<Section section="label">
					<ColourProperty name="NormalTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="EnabledHover">
			<Layer>
				<Section section="frame"/>
				<Section section="label">
					<ColourProperty name="NormalTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="EnabledPushed">
			<Layer>
				<Section section="pushframe"/>
				<Section section="label">
					<ColourProperty name="NormalTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="EnabledPopupOpen">
			<Layer>
				<Section section="frame"/>
				<Section section="label">
					<ColourProperty name="NormalTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledNormal">
			<Layer>
				<Section section="label">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledHover">
			<Layer>
				<Section section="frame">
					<Colour colour="FF7F7F7F"/>
				</Section>
				<Section section="label">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledPushed">
			<Layer>
				<Section section="frame">
					<Colour colour="FF7F7F7F"/>
				</Section>
				<Section section="label">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="DisabledPopupOpen">
			<Layer>
				<Section section="frame">
					<Colour colour="FF7F7F7F"/>
				</Section>
				<Section section="label">
					<ColourProperty name="DisabledTextColour"/>
				</Section>
			</Layer>
		</StateImagery>
		<StateImagery name="PopupClosedIcon">
			<Layer>
				<Section section="popup_arrow_right"/>
			</Layer>
		</StateImagery>
		<StateImagery name="PopupOpenIcon">
			<Layer>
				<Section section="popup_arrow_left"/>
			</Layer>
		</StateImagery>
	</WidgetLook>
