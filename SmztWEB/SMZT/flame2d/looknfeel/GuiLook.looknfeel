	<WidgetLook name="GlossySerpent/OrangeButton">
		<PropertyDefinition name="NormalTextColour" initialValue="fffef9d0" redrawOnWrite="true"/>
		<PropertyDefinition name="HoverTextColour" initialValue="FFFFFFff" redrawOnWrite="true"/>
		<PropertyDefinition name="PushedTextColour" initialValue="ff9e9966" redrawOnWrite="true"/>
		<PropertyDefinition name="DisabledTextColour" initialValue="ffcccccc" redrawOnWrite="true"/>
		<PropertyDefinition name="VertLabelFormatting" initialValue="CentreAligned"/>
		<PropertyDefinition name="HorzLabelFormatting" initialValue="CentreAligned"/>
		<ImagerySection name="label">
			<TextComponent>
				<Area>
					<Dim type="LeftEdge">
						<AbsoluteDim value="0"/>
					</Dim>
					<Dim type="TopEdge">
						<AbsoluteDim value="-2"/>
					</Dim>
