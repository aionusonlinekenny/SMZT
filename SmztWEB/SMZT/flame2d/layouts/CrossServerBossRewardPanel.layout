<GUILayout>
    <Window Name="CrossServerBossRewardPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,351},{0,404}}" />
        <Property Name="Text" Value="排名奖励" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_clickPos__">
            <Property Name="ClippedByParent" Value="false" />
        </AutoWindow>
        <Window Name="CrossServerBossRewardPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,362},{0,333},{0,363}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="CrossServerBossRewardPanel/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,333},{0,357}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="CrossServerBossRewardPanel/bg/HeaderList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,113},{0,28}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
                <Property Name="RightOffset" Value="10" />
                <Window Name="CrossServerBossRewardPanel/bg/HeaderList/StaticText" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,113},{0,28}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="排名" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="CrossServerBossRewardPanel/bg/HeaderList2" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,113},{0,0},{0,333},{0,28}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
                <Property Name="RightOffset" Value="10" />
                <Window Name="CrossServerBossRewardPanel/bg/HeaderList2/StaticText2" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,220},{0,28}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="排名奖励" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="CrossServerBossRewardPanel/bg/list" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,4},{0,29},{0,333},{0,350}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
