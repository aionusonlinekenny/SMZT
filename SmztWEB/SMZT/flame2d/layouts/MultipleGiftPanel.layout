<GUILayout>
    <Window Name="MultipleGiftPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,657},{0,424}}" />
        <Property Name="GlyphImage" Value="set:text image:MultiSelectGiftTxt" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="MultipleGiftPanel/line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,381},{0,639},{0,382}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="MultipleGiftPanel/bg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,639},{0,377}}" />
            <Property Name="Image" Value="set:multipleChoiceBg image:bg" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
            <Window Name="MultipleGiftPanel/bg/topUpBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,514},{0,5},{0,635},{0,45}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="前往充值" />
                <Property Name="HoverImage" Value="set:skins image:arrowHover" />
                <Property Name="NormalImage" Value="set:skins image:arrowNormal" />
                <Property Name="PushedImage" Value="set:skins image:arrowPushed" />
            </Window>
            <Window Name="MultipleGiftPanel/bg/giftNameTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,235},{0,18},{0,448},{0,61}}" />
                <Property Name="Font" Value="songti_18_strengh" />
                <Property Name="Text" Value="礼包名称" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FFFFea00" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="MultipleGiftPanel/bg/commonBg3" Type="GuiLook/CommonBg3">
                <Property Name="UnifiedAreaRect" Value="{{0,161},{0,108},{0,632},{0,366}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="MultipleGiftPanel/bg/commonBg3/list" Type="DefaultWindow">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,471},{0,258}}" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                </Window>
            </Window>
            <Window Name="MultipleGiftPanel/bg/threeStretchImage" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,161},{0,80},{0,632},{0,109}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:ListTitleBgLeft" />
                <Property Name="LeftOffset" Value="19" />
                <Property Name="RightImage" Value="set:skin image:ListTitleBgRight" />
                <Property Name="CenterImage" Value="set:skin image:ListTitleBgCenter" />
                <Property Name="RightOffset" Value="19" />
                <Window Name="MultipleGiftPanel/bg/threeStretchImage/staticText" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,471},{0,29}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="四种礼包只可领取一种，请慎重选择后领取！！！" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FFFef9d0" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
        </Window>
    </Window>
</GUILayout>