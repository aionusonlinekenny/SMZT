<GUILayout>
    <Window Name="CityHalo" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,7},{0,54},{0,1034},{0,521}}" />
        <Property Name="Text" Value="购买多个可叠加光环效果" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="CityHalo/bgImg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,505},{0,421}}" />
            <Property Name="Image" Value="set:cityHaloBg image:haloBg" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="CityHalo/bgImg2" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,505},{0,0},{0,1010},{0,421}}" />
            <Property Name="Image" Value="set:cityHaloBg image:haloBg" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="CityHalo/nullImg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,1010},{0,421}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
            <Property Name="MousePassThroughEnabled" Value="true" />
        </Window>
    </Window>
</GUILayout>