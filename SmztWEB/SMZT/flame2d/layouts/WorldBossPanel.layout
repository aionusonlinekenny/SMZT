            <Property Name="Text" Value="精英" />
            <Property Name="HoverImage" Value="set:skin image:tabBBtnHover" />
            <Property Name="SelectedImage" Value="set:skin image:tabBBtnHover" />
            <Property Name="ClippedByParent" Value="false" />
            <Property Name="UnselectedImage" Value="set:skin image:tabBBtnNormal" />
        </Window>
        <Window Name="WorldBossPanel/chooseBtn3" Type="GuiLook/RadioTab">
            <Property Name="UnifiedAreaRect" Value="{{0,-63},{0,91},{0,0},{0,132}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="世界" />
            <Property Name="HoverImage" Value="set:skin image:tabBBtnHover" />
