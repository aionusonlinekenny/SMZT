<GUILayout>
    <Window Name="GetRewardPrompt" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,297},{0,161}}" />
        <Property Name="Text" Value="领奖提示" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="GetRewardPrompt/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,1},{0,81},{0,280},{0,82}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
        <Window Name="GetRewardPrompt/goBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,1},{0,91},{0,88},{0,114}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="立即领取" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
        <Window Name="GetRewardPrompt/DefaultWindow" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,280},{0,88}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="GetRewardPrompt/DefaultWindow/desc" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,17},{0,273},{0,43}}" />
                <Property Name="Font" Value="songti_14" />
                <Property Name="Text" Value="恭喜您，获得礼包奖励" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="ffffffff" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="HorizontalAlignment" Value="Centre" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="GetRewardPrompt/DefaultWindow/desc$RI" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,50},{0,272},{0,68}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="待领礼包：XXX礼包" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="ffffffff" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
        </Window>
    </Window>
</GUILayout>