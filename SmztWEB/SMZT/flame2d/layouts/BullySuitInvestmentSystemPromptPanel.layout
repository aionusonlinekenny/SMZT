<GUILayout>
    <Window Name="StockInvestmentSystemPromptPanel" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,5},{0,4},{0,365},{0,187}}" />
        <Property Name="Font" Value="songti_18_strengh" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="StockInvestmentSystemPromptPanel/line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,111},{0,346},{0,112}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="StockInvestmentSystemPromptPanel/btnSp1" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,112},{0,346},{0,140}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="StockInvestmentSystemPromptPanel/btnSp1/buyBtn" Type="GlossySerpent/OrangeButton">
                <Property Name="UnifiedAreaRect" Value="{{0,63},{0,4},{0,144},{0,27}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="充值" />
            </Window>
            <Window Name="StockInvestmentSystemPromptPanel/btnSp1/cancelBtn" Type="GlossySerpent/BlueButton">
                <Property Name="UnifiedAreaRect" Value="{{0,205},{0,4},{0,286},{0,27}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="取消" />
            </Window>
        </Window>
        <Window Name="StockInvestmentSystemPromptPanel/additionalSp" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,346},{0,110}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="StockInvestmentSystemPromptPanel/additionalSp/additionalTitleTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,35},{0,16},{0,335},{0,42}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text">追加投资          成功，补领绑定元宝
</Property>
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FFfef9d0" />
                <Property Name="WantsMultiClickEvents" Value="false" />
                <Window Name="StockInvestmentSystemPromptPanel/additionalSp/additionalTitleTxt/additionalTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,60},{0,0},{0,160},{0,26}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="10000元宝" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FFcc43ff" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="StockInvestmentSystemPromptPanel/additionalSp/gridSp" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,148},{0,52},{0,196},{0,100}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
            </Window>
        </Window>
        <Window Name="StockInvestmentSystemPromptPanel/btnSp2" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,112},{0,346},{0,140}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="StockInvestmentSystemPromptPanel/btnSp2/sureBtn" Type="GlossySerpent/BlueButton">
                <Property Name="UnifiedAreaRect" Value="{{0,135},{0,4},{0,216},{0,27}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="确定" />
            </Window>
        </Window>
        <Window Name="StockInvestmentSystemPromptPanel/buyTitleTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,-34},{0,215},{0,-1}}" />
            <Property Name="Font" Value="songti_16_strengh" />
            <Property Name="Text" Value="提示" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFc6dee6" />
            <Property Name="ClippedByParent" Value="false" />
            <Property Name="WantsMultiClickEvents" Value="false" />
            <Property Name="MousePassThroughEnabled" Value="true" />
        </Window>
        <Window Name="StockInvestmentSystemPromptPanel/topUpSp" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,346},{0,110}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="StockInvestmentSystemPromptPanel/topUpSp/topUpTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,179},{0,42},{0,255},{0,62}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="【天天返利】" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FFcc43ff" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="StockInvestmentSystemPromptPanel/topUpSp/topUpTitleTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,55},{0,42},{0,179},{0,62}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="元宝不足！无法参与" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="StockInvestmentSystemPromptPanel/topUpSp/topUpFooterTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,255},{0,42},{0,284},{0,62}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="投资" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="StockInvestmentSystemPromptPanel/topUpSp/isTopUpTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,124},{0,64},{0,220},{0,84}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="是否前往充值？" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
        </Window>
    </Window>
</GUILayout>