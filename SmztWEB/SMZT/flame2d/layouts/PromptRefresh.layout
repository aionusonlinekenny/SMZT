<GUILayout>
    <Window Name="PromptRefresh" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,316},{0,162}}" />
        <Property Name="Text" Value="温馨提示" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="PromptRefresh/bg" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,302},{0,119}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="PromptRefresh/bg/Line" Type="GuiLook/Line">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,87},{0,305},{0,88}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
            <Window Name="PromptRefresh/bg/OrangeButton" Type="GlossySerpent/OrangeButton">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,94},{0,70},{0,117}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="刷新生效" />
                <Property Name="HorizontalAlignment" Value="Centre" />
            </Window>
            <Window Name="PromptRefresh/bg/StaticText2" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,34},{0,305},{0,57}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="如已勾选硬件加速，刷新后将会生效" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FF85f500" />
                <Property Name="VertFormatting" Value="TopAligned" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="PromptRefresh/bg/swfArrowBox" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,-69},{0,-1},{0,45},{0,50}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Window Name="PromptRefresh/bg/swfArrowBox/swfArrow" Type="GuiLook/StaticImage">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,114},{0,51}}" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="FrameEnabled" Value="false" />
                    <Property Name="BackgroundEnabled" Value="false" />
                    <Property Name="RiseOnClick" Value="false" />
                </Window>
                <Window Name="PromptRefresh/bg/swfArrowBox/StaticText" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,114},{0,51}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="启用硬件加速" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
        </Window>
    </Window>
</GUILayout>