        </Window>
        <Window Name="TreasureHuntWagerShopPanel/gridBox" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,3},{0,34},{0,327},{0,492}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
    </Window>
</GUILayout>