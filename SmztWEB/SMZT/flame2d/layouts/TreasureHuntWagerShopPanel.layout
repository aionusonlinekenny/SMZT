<GUILayout>
    <Window Name="TreasureHuntWagerShopPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,82},{0,10},{0,430},{0,587}}" />
        <Property Name="Text" Value="宝藏仓库" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="TreasureHuntWagerShopPanel/capacityvalue" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,63},{0,504},{0,153},{0,525}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="200/200" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/capacity" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,1},{0,504},{0,62},{0,525}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="仓库容量：" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF64d4d8" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/tidyBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,266},{0,502},{0,330},{0,525}}" />
            <Property Name="Text" Value="全部取出" />
            <Property Name="AlwaysOnTop" Value="true" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/commonBG" Type="GuiLook/CommonBG">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,29},{0,330},{0,495}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/allBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,5},{0,4},{0,63},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="全部" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/otherBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,249},{0,4},{0,307},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="其他" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/toolsBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,188},{0,4},{0,246},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="道具" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/medicineBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,127},{0,4},{0,185},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="药水" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/equipmentBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,66},{0,4},{0,124},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="装备" />
        </Window>
        <Window Name="TreasureHuntWagerShopPanel/line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,534},{0,335},{0,535}}" />
