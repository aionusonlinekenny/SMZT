<GUILayout>
    <Window Name="ConsignmentSell" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,256},{0,320}}" />
        <Property Name="Text" Value="货品出售" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="ConsignmentSell/bg" Type="GuiLook/CommonBg2">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,238},{0,243}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="ConsignmentSell/bg/titleImg" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,238},{0,29}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:ListTitleBgLeft" />
                <Property Name="LeftOffset" Value="19" />
                <Property Name="RightImage" Value="set:skin image:ListTitleBgRight" />
                <Property Name="CenterImage" Value="set:skin image:ListTitleBgCenter" />
                <Property Name="RightOffset" Value="19" />
                <Window Name="ConsignmentSell/bg/titleImg/nameTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,238},{0,29}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="道具名称品质色" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FFcc43ff" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="ConsignmentSell/bg/Line" Type="GuiLook/Line">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,96},{0,238},{0,97}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
            <Window Name="ConsignmentSell/bg/Line2" Type="GuiLook/Line">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,201},{0,238},{0,202}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
            <Window Name="ConsignmentSell/bg/props" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,95},{0,38},{0,143},{0,86}}" />
                <Property Name="Image" Value="set:skin image:GridBG2" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
            </Window>
            <Window Name="ConsignmentSell/bg/numberTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,16},{0,119},{0,52},{0,137}}" />
                <Property Name="Font" Value="songti_12_strengh" />
                <Property Name="Text" Value="数量：" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="ConsignmentSell/bg/priceTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,16},{0,158},{0,52},{0,176}}" />
                <Property Name="Font" Value="songti_12_strengh" />
                <Property Name="Text" Value="总价：" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="ConsignmentSell/bg/TextBG" Type="GuiLook/TextBG">
                <Property Name="UnifiedAreaRect" Value="{{0,59},{0,155},{0,213},{0,176}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="ConsignmentSell/bg/TextBG/yuanbaoImg" Type="GuiLook/StaticImage">
                    <Property Name="UnifiedAreaRect" Value="{{0,1},{0,1},{0,20},{0,20}}" />
                    <Property Name="Image" Value="set:mainUI1 image:yuanbao" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="FrameEnabled" Value="false" />
                    <Property Name="HorzFormatting" Value="CentreAligned" />
                    <Property Name="VertFormatting" Value="CentreAligned" />
                    <Property Name="BackgroundEnabled" Value="false" />
                    <Property Name="RiseOnClick" Value="false" />
                </Window>
                <Window Name="ConsignmentSell/bg/TextBG/yuanbaoTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,26},{0,0},{0,141},{0,21}}" />
                    <Property Name="Font" Value="songti_12_strengh" />
                    <Property Name="Text" Value="1111" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="ConsignmentSell/bg/reductionBtn" Type="GuiLook/DefaultImageButton">
                <Property Name="UnifiedAreaRect" Value="{{0,59},{0,116},{0,80},{0,137}}" />
                <Property Name="Image" Value="set:skin image:reductionBtn" />
            </Window>
            <Window Name="ConsignmentSell/bg/addBtn" Type="GuiLook/DefaultImageButton">
                <Property Name="UnifiedAreaRect" Value="{{0,194},{0,116},{0,215},{0,137}}" />
                <Property Name="Image" Value="set:skin image:addBtn" />
            </Window>
            <Window Name="ConsignmentSell/bg/TextBG2" Type="GuiLook/TextBG">
                <Property Name="UnifiedAreaRect" Value="{{0,82},{0,116},{0,192},{0,137}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="ConsignmentSell/bg/TextBG2/input" Type="GuiLook/Editbox">
                    <Property Name="UnifiedAreaRect" Value="{{0,1},{0,-4},{0,109},{0,23}}" />
                </Window>
            </Window>
            <Window Name="ConsignmentSell/bg/descTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,213},{0,238},{0,231}}" />
                <Property Name="Font" Value="songti_12" />
                <Property Name="Text" Value="交易成功直接扣除背包中相应数量道具" />
