<GUILayout>
    <Window Name="CityPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,1002},{0,648}}" />
        <Property Name="GlyphImage" Value="set:cityGeneral image:sky" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="CityPanel/background" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,31},{0,984},{0,602}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="CityPanel/plunderBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,6},{0,5},{0,81},{0,29}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="领地掠夺" />
        </Window>
        <Window Name="CityPanel/cityBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,82},{0,5},{0,157},{0,29}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="皇城争霸" />
        </Window>
        <Window Name="CityPanel/plunderBtn1" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,158},{0,5},{0,233},{0,29}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="斗战神" />
        </Window>
        <Window Name="CityPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,606},{0,984},{0,607}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
    </Window>
</GUILayout>