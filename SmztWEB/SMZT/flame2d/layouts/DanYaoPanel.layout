<GUILayout>
    <Window Name="DanYaoPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,283},{0,568}}" />
        <Property Name="Text" Value="丹药" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="DanYaoPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,525},{0,263},{0,526}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="DanYaoPanel/bg" Type="GuiLook/CommonBG">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,265},{0,488}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="DanYaoPanel/bg/StaticImage" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,265},{0,58}}" />
                <Property Name="Image" Value="set:text image:DanTxt" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
            </Window>
            <Window Name="DanYaoPanel/bg/Listbox" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,4},{0,60},{0,261},{0,483}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
        </Window>
        <Window Name="DanYaoPanel/StaticText" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,1},{0,497},{0,266},{0,517}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="丹药服用上限随人物等级增加而增加！" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF85f500" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
    </Window>
</GUILayout>