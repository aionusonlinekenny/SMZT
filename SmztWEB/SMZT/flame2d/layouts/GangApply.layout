<GUILayout>
    <Window Name="GangApply" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,365},{0,266}}" />
        <Property Name="Text" Value="入帮申请" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="GangApply/background" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,347},{0,191}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="GangApply/background/boxList" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,347},{0,155}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
            <Window Name="GangApply/background/pageLastBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,125},{0,162},{0,145},{0,182}}" />
                <Property Name="HoverImage" Value="set:skin image:LastBtnHover" />
                <Property Name="NormalImage" Value="set:skin image:LastBtnNormal" />
                <Property Name="PushedImage" Value="set:skin image:LastBtnPushed" />
                <Property Name="DisabledImage" Value="set:skin image:LastBtnDisable" />
            </Window>
            <Window Name="GangApply/background/pageNextBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,195},{0,162},{0,215},{0,182}}" />
                <Property Name="HoverImage" Value="set:skin image:NextBtnHover" />
                <Property Name="NormalImage" Value="set:skin image:NextBtnNormal" />
                <Property Name="PushedImage" Value="set:skin image:NextBtnPushed" />
                <Property Name="DisabledImage" Value="set:skin image:NextBtnDisable" />
            </Window>
            <Window Name="GangApply/background/laPageBg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,149},{0,163},{0,191},{0,181}}" />
                <Property Name="Image" Value="set:skin image:RenderBg2" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Window Name="GangApply/background/laPageBg/pageTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,42},{0,18}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="250" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF64d4d8" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
        </Window>
        <Window Name="GangApply/btn_1" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,60},{0,195},{0,147},{0,218}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="全部同意" />
        </Window>
        <Window Name="GangApply/btn_2" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,192},{0,195},{0,279},{0,218}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="全部拒绝" />
        </Window>
