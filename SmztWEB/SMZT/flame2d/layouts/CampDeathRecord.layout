                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="CampDeathRecord/bg/boxList" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,28},{0,367},{0,259}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
        </Window>
        <Window Name="CampDeathRecord/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,295},{0,367},{0,296}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="CampDeathRecord/btn_1" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,268},{0,87},{0,291}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="确定" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
    </Window>
</GUILayout>