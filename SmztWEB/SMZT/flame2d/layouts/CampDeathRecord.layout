<GUILayout>
    <Window Name="CampDeathRecord" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,385},{0,338}}" />
        <Property Name="Text" Value="阵亡记录" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="CampDeathRecord/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,367},{0,263}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="CampDeathRecord/bg/nameList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,124},{0,0},{0,367},{0,28}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
                <Property Name="RightOffset" Value="10" />
                <Window Name="CampDeathRecord/bg/nameList/nameTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,244},{0,28}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="仇人或掉落" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="CampDeathRecord/bg/locationList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,46},{0,0},{0,124},{0,28}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
                <Property Name="RightOffset" Value="10" />
                <Window Name="CampDeathRecord/bg/locationList/locationTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,78},{0,28}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="地点" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="CampDeathRecord/bg/dropList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,264},{0,0},{0,367},{0,28}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="Visible" Value="false" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
                <Property Name="RightOffset" Value="10" />
                <Window Name="CampDeathRecord/bg/dropList/dropTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,103},{0,28}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="掉落" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="CampDeathRecord/bg/timeList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,46},{0,28}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
