<GUILayout>
    <Window Name="TitleGetAlert" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,334},{0,183}}" />
        <Property Name="Text" Value="获得新称号" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="TitleGetAlert/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,320},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="TitleGetAlert/checkBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,170},{0,117},{0,257},{0,140}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="查看称号" />
        </Window>
        <Window Name="TitleGetAlert/useBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,72},{0,117},{0,159},{0,140}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="立即启用" />
        </Window>
        <Window Name="TitleGetAlert/chengHaoImg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,22},{0,320},{0,90}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="HorzFormatting" Value="CentreAligned" />
            <Property Name="VertFormatting" Value="CentreAligned" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
    </Window>
</GUILayout>