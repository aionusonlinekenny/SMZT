<GUILayout>
    <Window Name="RelivePanel" Type="DefaultWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,430},{0,249}}" />
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Property Name="VerticalAlignment" Value="Centre" />
        <Property Name="HorizontalAlignment" Value="Centre" />
        <Window Name="RelivePanel/bg" Type="GlossySerpent/ThreeVStretchImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,430},{0,249}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TopImage" Value="set:relive image:strongTop" />
