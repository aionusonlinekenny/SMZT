                    <Property Name="BackgroundEnabled" Value="false" />
                    <Property Name="RiseOnClick" Value="false" />
                    <Property Name="HorizontalAlignment" Value="Centre" />
                </Window>
                <Window Name="RelivePanel/bg/CommonBg2/list" Type="DefaultWindow">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,30},{0,412},{0,135}}" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                </Window>
            </Window>
            <Window Name="RelivePanel/bg/RedButton" Type="GlossySerpent/RedButton">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,198},{0,146},{0,238}}" />
