            <Window Name="RelivePanel/bg/closeBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,406},{0,8},{0,423},{0,25}}" />
                <Property Name="HoverImage" Value="set:mainUI1 image:closeHover" />
                <Property Name="NormalImage" Value="set:mainUI1 image:closeNormal" />
                <Property Name="PushedImage" Value="set:mainUI1 image:closePushed" />
            </Window>
            <Window Name="RelivePanel/bg/link$RI" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,316},{0,20},{0,375},{0,36}}" />
