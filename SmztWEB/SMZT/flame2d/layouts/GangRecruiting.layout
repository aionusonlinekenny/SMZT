                </Window>
            </Window>
            <Window Name="GangRecruiting/background/TextBG" Type="GuiLook/TextBG">
                <Property Name="UnifiedAreaRect" Value="{{0,4},{0,4},{0,238},{0,25}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="GangRecruiting/background/TextBG/input" Type="GuiLook/Editbox">
                    <Property Name="UnifiedAreaRect" Value="{{0,-2},{0,-2},{0,232},{0,24}}" />
