<GUILayout>
    <Window Name="GangRecruiting" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,351},{0,295}}" />
        <Property Name="Text" Value="招募成员" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="GangRecruiting/background" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,333},{0,217}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="GangRecruiting/background/nameList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,29},{0,162},{0,57}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
                <Property Name="RightOffset" Value="10" />
                <Window Name="GangRecruiting/background/nameList/nameTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,162},{0,28}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="玩家名称" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="GangRecruiting/background/levelList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,162},{0,29},{0,236},{0,57}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
                <Property Name="RightOffset" Value="10" />
                <Window Name="GangRecruiting/background/levelList/levelTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,74},{0,28}}" />
                    <Property Name="Font" Value="songti_14_strengh" />
                    <Property Name="Text" Value="等级" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF65b3e9" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="GangRecruiting/background/professionalList" Type="GlossySerpent/ThreeStretchImage">
                <Property Name="UnifiedAreaRect" Value="{{0,236},{0,29},{0,332},{0,57}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="LeftImage" Value="set:skin image:HeadLeft" />
                <Property Name="LeftOffset" Value="10" />
                <Property Name="RightImage" Value="set:skin image:HeadRight" />
                <Property Name="CenterImage" Value="set:skin image:HeadMiddle" />
