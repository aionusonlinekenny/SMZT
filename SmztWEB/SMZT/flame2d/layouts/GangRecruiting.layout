        </Window>
        <Window Name="GangRecruiting/viewBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,36},{0,222},{0,154},{0,245}}" />
            <Property Name="Font" Value="songti_14_strengh" />
