<GUILayout>
    <Window Name="GangPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,124},{0,78},{0,895},{0,617}}" />
        <Property Name="GlyphImage" Value="set:gangGeneral image:gang" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_clickPos__">
            <Property Name="ClippedByParent" Value="false" />
        </AutoWindow>
        <Window Name="GangPanel/background" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,30},{0,753},{0,493}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="GangPanel/background/boxSp" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,753},{0,463}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
        </Window>
        <Window Name="GangPanel/notParty" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,159},{0,30}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="Visible" Value="false" />
            <Window Name="GangPanel/notParty/creatGangBtn1" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,4},{0,5},{0,79},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="创建帮派" />
            </Window>
            <Window Name="GangPanel/notParty/ganglistBtn1" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,80},{0,5},{0,155},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="帮派列表" />
            </Window>
        </Window>
        <Window Name="GangPanel/hasParty" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,537},{0,30}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="MousePassThroughEnabled" Value="true" />
            <Window Name="GangPanel/hasParty/creatGangBtn" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,4},{0,5},{0,79},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="我的帮派" />
            </Window>
            <Window Name="GangPanel/hasParty/gangConstructionBtn" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,80},{0,5},{0,155},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="帮派建设" />
            </Window>
            <Window Name="GangPanel/hasParty/gangYuanbaoBtn" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,156},{0,5},{0,231},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="帮派元宝" />
            </Window>
            <Window Name="GangPanel/hasParty/gangListBtn" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,384},{0,5},{0,459},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="帮派列表" />
            </Window>
            <Window Name="GangPanel/hasParty/gangFunctionBtn" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,308},{0,5},{0,383},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="帮派功能" />
            </Window>
            <Window Name="GangPanel/hasParty/gangMallBtn" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,232},{0,5},{0,307},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="帮派BOSS" />
            </Window>
            <Window Name="GangPanel/hasParty/gangBossBtn" Type="GuiLook/CommonRadioButton">
                <Property Name="UnifiedAreaRect" Value="{{0,460},{0,5},{0,535},{0,29}}" />
                <Property Name="Font" Value="songti_14_strengh" />
                <Property Name="Text" Value="帮派BOSS" />
                <Property Name="Visible" Value="false" />
            </Window>
        </Window>
    </Window>
</GUILayout>