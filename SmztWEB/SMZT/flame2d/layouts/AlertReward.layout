<GUILayout>
    <Window Name="AlertReward" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,360},{0,183}}" />
        <Property Name="Text" Value="领奖提示" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="AlertReward/grid" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,24},{0,24},{0,72},{0,72}}" />
            <Property Name="Image" Value="set:skin image:GridBG" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="AlertReward/nameTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,102},{0,25},{0,309},{0,49}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="AlertReward/StaticText2" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,80},{0,59},{0,327},{0,83}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="恭喜您可以领取该礼包了" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="ff85f500" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="AlertReward/rewardBtn" Type="GlossySerpent/OrangeButton">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,108},{0,81},{0,131}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="前往领取" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
    </Window>
</GUILayout>