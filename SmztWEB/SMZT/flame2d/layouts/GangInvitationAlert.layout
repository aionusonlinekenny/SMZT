        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="GangInvitationAlert/number1Txt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,201},{0,33},{0,286},{0,51}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="1" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFFFea00" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="GangInvitationAlert/btn_2" Type="GlossySerpent/BlueButton">
