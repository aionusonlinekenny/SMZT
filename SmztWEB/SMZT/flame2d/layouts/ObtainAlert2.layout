            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="ObtainAlert2/di" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,-2},{0,61},{0,318},{0,122}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="ObtainAlert2/di/upImg3" Type="GuiLook/StaticImage">
