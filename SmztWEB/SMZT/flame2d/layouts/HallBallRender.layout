<GUILayout>
    <Window Name="HallBallRender" Type="DefaultWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,70},{0,120}}" />
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Property Name="ClippedByParent" Value="false" />
        <Window Name="HallBallRender/ballImg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,24},{0,26},{0,71},{0,78}}" />
            <Property Name="Image" Value="set:hallReward image:redbtn" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
            <Window Name="HallBallRender/ballImg/ballTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,-1},{0,0},{0,44},{0,47}}" />
                <Property Name="Font" Value="songti_18_strengh" />
                <Property Name="Text" Value="5" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FF00baff" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
        </Window>
        <Window Name="HallBallRender/activeTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,12},{0,91},{0,36},{0,109}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="500" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF85d500" />
            <Property Name="HorzTextFormatting" Value="RightAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="HallBallRender/activateBtn" Type="GlossySerpent/OrangeButton">
            <Property Name="UnifiedAreaRect" Value="{{0,3},{0,4},{0,85},{0,27}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="激活领取" />
            <Property Name="ClippedByParent" Value="false" />
            <Window Name="HallBallRender/activateBtn/rewardFilter" Type="GuiLook/ButtonFilter">
                <Property Name="UnifiedAreaRect" Value="{{0,-5},{0,-5},{0,87},{0,28}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="ClippedByParent" Value="false" />
                <Property Name="MousePassThroughEnabled" Value="true" />
            </Window>
        </Window>
        <Window Name="HallBallRender/wordTxt2" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,37},{0,91},{0,78},{0,108}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="活跃度" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF00bafF" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
    </Window>
</GUILayout>