<GUILayout>
    <Window Name="Warehouse" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,82},{0,10},{0,430},{0,578}}" />
        <Property Name="GlyphImage" Value="set:text image:warehouse" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="Warehouse/capacityvalue" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,63},{0,499},{0,114},{0,520}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="200/200" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="Warehouse/capacity" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,1},{0,499},{0,62},{0,520}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="仓库容量：" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF64d4d8" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="Warehouse/tidyBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,266},{0,497},{0,330},{0,520}}" />
            <Property Name="Text" Value="整 理" />
            <Property Name="AlwaysOnTop" Value="true" />
            <Property Name="Tooltip" Value="整理包裹里所有道具" />
        </Window>
        <Window Name="Warehouse/commonBG" Type="GuiLook/CommonBG">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,29},{0,330},{0,495}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="Warehouse/allBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,5},{0,4},{0,63},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="全部" />
        </Window>
        <Window Name="Warehouse/otherBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,249},{0,4},{0,307},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="其他" />
        </Window>
        <Window Name="Warehouse/toolsBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,188},{0,4},{0,246},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="工具" />
        </Window>
        <Window Name="Warehouse/medicineBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,127},{0,4},{0,185},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="药水" />
        </Window>
        <Window Name="Warehouse/equipmentBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,66},{0,4},{0,124},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="装备" />
        </Window>
        <Window Name="Warehouse/line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,525},{0,335},{0,526}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="Warehouse/gridBox" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,8},{0,38},{0,324},{0,488}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="Warehouse/scrollBar" Type="GuiLook/VerticalScrollbar">
            <Property Name="UnifiedAreaRect" Value="{{0,313},{0,33},{0,327},{0,490}}" />
            <Property Name="VerticalScrollbar" Value="true" />
        </Window>
    </Window>
</GUILayout>