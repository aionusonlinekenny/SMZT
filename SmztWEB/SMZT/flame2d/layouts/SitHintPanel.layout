<GUILayout>
    <Window Name="SitHintPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,365},{0,266}}" />
        <Property Name="Text" Value="双修邀请" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="SitHintPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,223},{0,347},{0,224}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="SitHintPanel/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,347},{0,191}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="SitHintPanel/bg/pageNextBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,200},{0,164},{0,220},{0,184}}" />
                <Property Name="HoverImage" Value="set:skin image:NextBtnHover" />
                <Property Name="NormalImage" Value="set:skin image:NextBtnNormal" />
                <Property Name="PushedImage" Value="set:skin image:NextBtnPushed" />
            </Window>
            <Window Name="SitHintPanel/bg/pageSp" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,154},{0,165},{0,196},{0,183}}" />
                <Property Name="Image" Value="set:skin image:pageBg" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Window Name="SitHintPanel/bg/pageSp/pageTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,2},{0,1},{0,40},{0,17}}" />
                    <Property Name="Font" Value="" />
                    <Property Name="Text" Value="1/2" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="SitHintPanel/bg/pagePreBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,130},{0,164},{0,150},{0,184}}" />
                <Property Name="HoverImage" Value="set:skin image:LastBtnHover" />
                <Property Name="NormalImage" Value="set:skin image:LastBtnNormal" />
                <Property Name="PushedImage" Value="set:skin image:LastBtnPushed" />
            </Window>
            <Window Name="SitHintPanel/bg/list" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,1},{0,1},{0,346},{0,162}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
        </Window>
        <Window Name="SitHintPanel/refusedBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,195},{0,90},{0,218}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="全部拒绝" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
    </Window>
</GUILayout>