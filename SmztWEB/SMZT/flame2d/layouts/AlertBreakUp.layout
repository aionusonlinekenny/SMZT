<GUILayout>
    <Window Name="AlertBreakUp" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,360},{0,183}}" />
        <Property Name="Text" Value="拆分" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="AlertBreakUp/titleTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,46},{0,15},{0,312},{0,35}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="您的物品将拆分为两堆，请输入要拆分数量：" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="AlertBreakUp/reductionBtn" Type="GuiLook/DefaultImageButton">
            <Property Name="UnifiedAreaRect" Value="{{0,97},{0,43},{0,118},{0,64}}" />
            <Property Name="Image" Value="set:skin image:reductionBtn" />
        </Window>
        <Window Name="AlertBreakUp/pushTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,64},{0,46},{0,95},{0,61}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="放入" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFFef9d0" />
            <Property Name="VertFormatting" Value="TopAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="AlertBreakUp/Line2" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,346},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="AlertBreakUp/textBg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,120},{0,43},{0,239},{0,64}}" />
            <Property Name="Image" Value="set:mainUI1 image:nameLeft" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
            <Window Name="AlertBreakUp/textBg/input" Type="GuiLook/Editbox">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,119},{0,21}}" />
            </Window>
        </Window>
        <Window Name="AlertBreakUp/addBtn" Type="GuiLook/DefaultImageButton">
            <Property Name="UnifiedAreaRect" Value="{{0,241},{0,43},{0,262},{0,64}}" />
            <Property Name="Image" Value="set:skin image:addBtn" />
        </Window>
        <Window Name="AlertBreakUp/sureBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,116},{0,87},{0,139}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="确认" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
    </Window>
</GUILayout>