<GUILayout>
    <Window Name="TaskPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,662},{0,512}}" />
        <Property Name="GlyphImage" Value="set:task image:task" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="TaskPanel/boxSP" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,-1},{0,30},{0,643},{0,463}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="TaskPanel/mainTaskBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,4},{0,4},{0,79},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="主线任务" />
        </Window>
        <Window Name="TaskPanel/colorsTaskBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,235},{0,4},{0,310},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="奇缘任务" />
        </Window>
        <Window Name="TaskPanel/rewordTaskBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,158},{0,4},{0,233},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="悬赏任务" />
        </Window>
        <Window Name="TaskPanel/runLoopTaskBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,81},{0,4},{0,156},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="跑环任务" />
        </Window>
        <Window Name="TaskPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,467},{0,644},{0,468}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
    </Window>
</GUILayout>