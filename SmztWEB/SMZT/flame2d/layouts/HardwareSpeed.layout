            <Property Name="Text" Value="我要启用" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
        <Window Name="HardwareSpeed/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,87},{0,305},{0,88}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="HardwareSpeed/swfArrowBox" Type="GuiLook/StaticImage">
