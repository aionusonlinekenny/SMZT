            <Property Name="TextColour" Value="FFFF0000" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="HardwareSpeed/StaticText2" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,34},{0,305},{0,57}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="按照以下步骤操作可解决您的问题，您需要" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFffffff" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="HardwareSpeed/StaticText22" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,58},{0,305},{0,81}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="开启            功能" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFffffff" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="HardwareSpeed/StaticText222" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,58},{0,305},{0,81}}" />
            <Property Name="Font" Value="songti_12_strengh" />
