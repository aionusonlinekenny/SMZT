<GUILayout>
    <Window Name="OverdueAlert" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,334},{0,183}}" />
        <Property Name="Text" Value="过期提示" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="OverdueAlert/qualityImg" Type="GlossySerpent/ThreeStretchImage">
            <Property Name="UnifiedAreaRect" Value="{{0,31},{0,15},{0,106},{0,100}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="LeftImage" Value="set:changeGeneral image:qualityLeft1" />
            <Property Name="LeftOffset" Value="3" />
            <Property Name="RightImage" Value="set:changeGeneral image:qualityRight1" />
            <Property Name="CenterImage" Value="set:changeGeneral image:qualityMiddle1" />
            <Property Name="RightOffset" Value="3" />
            <Property Name="RiseOnClick" Value="false" />
            <Property Name="MousePassThroughEnabled" Value="true" />
            <Window Name="OverdueAlert/qualityImg/diImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,2},{0,2},{0,73},{0,83}}" />
                <Property Name="Image" Value="set:changeGeneral image:quality1" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Property Name="MousePassThroughEnabled" Value="true" />
                <Window Name="OverdueAlert/qualityImg/diImg/faceImg" Type="GuiLook/StaticImage">
                    <Property Name="UnifiedAreaRect" Value="{{0,1},{0,1},{0,70},{0,80}}" />
                    <Property Name="Image" Value="set:changeGeneral image:s_11001" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="FrameEnabled" Value="false" />
                    <Property Name="BackgroundEnabled" Value="false" />
                    <Property Name="RiseOnClick" Value="false" />
                    <Property Name="MousePassThroughEnabled" Value="true" />
                </Window>
                <Window Name="OverdueAlert/qualityImg/diImg/nameSp" Type="GuiLook/StaticImage">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,65},{0,71},{0,81}}" />
                    <Property Name="Image" Value="set:changeGeneral image:nameBg" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="FrameEnabled" Value="false" />
                    <Property Name="BackgroundEnabled" Value="false" />
                    <Property Name="RiseOnClick" Value="false" />
                    <Property Name="MousePassThroughEnabled" Value="true" />
                    <Window Name="OverdueAlert/qualityImg/diImg/nameSp/attributeImg" Type="GuiLook/StaticImage">
                        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,19},{0,16}}" />
                        <Property Name="Image" Value="set:changeGeneral image:icon_0" />
                        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                        <Property Name="FrameEnabled" Value="false" />
                        <Property Name="BackgroundEnabled" Value="false" />
                        <Property Name="RiseOnClick" Value="false" />
                        <Property Name="MousePassThroughEnabled" Value="true" />
                    </Window>
                    <Window Name="OverdueAlert/qualityImg/diImg/nameSp/nameTxt" Type="GuiLook/StaticText">
                        <Property Name="UnifiedAreaRect" Value="{{0,19},{0,0},{0,71},{0,16}}" />
                        <Property Name="Font" Value="songti_12_strengh" />
                        <Property Name="Text" Value="典韦" />
                        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                        <Property Name="DropTextColour" Value="" />
                        <Property Name="HorzTextFormatting" Value="CenterAligned" />
                        <Property Name="RiseOnClick" Value="false" />
                        <Property Name="WantsMultiClickEvents" Value="false" />
                        <Property Name="MousePassThroughEnabled" Value="true" />
                    </Window>
                </Window>
            </Window>
        </Window>
        <Window Name="OverdueAlert/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,320},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="OverdueAlert/sureBtn" Type="GlossySerpent/OrangeButton">
            <Property Name="UnifiedAreaRect" Value="{{0,113},{0,117},{0,200},{0,140}}" />
