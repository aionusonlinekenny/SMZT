<GUILayout>
    <Window Name="GangThanksAlert" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,30},{0,55},{0,390},{0,238}}" />
        <Property Name="Text" Value="感谢" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="GangThanksAlert/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,346},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="GangThanksAlert/props" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,30},{0,21},{0,78},{0,69}}" />
            <Property Name="Image" Value="set:skin image:GridBG" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="GangThanksAlert/desc$RI" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,83},{0,2},{0,340},{0,84}}" />
            <Property Name="Font" Value="" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="GangThanksAlert/descTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,8},{0,118},{0,48},{0,136}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="送出：" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="GangThanksAlert/btn_1" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,244},{0,116},{0,331},{0,139}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="答谢并领取" />
        </Window>
        <Window Name="GangThanksAlert/smallBg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,55},{0,117},{0,235},{0,138}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="GangThanksAlert/smallBg/bgImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,1},{0,1},{0,179},{0,20}}" />
                <Property Name="Image" Value="set:skin image:RenderBg2" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Window Name="GangThanksAlert/smallBg/bgImg/downBtn" Type="GuiLook/DefaultButton">
                    <Property Name="UnifiedAreaRect" Value="{{0,159},{0,0},{0,178},{0,19}}" />
                    <Property Name="HoverImage" Value="set:skin image:dropDownHover" />
                    <Property Name="NormalImage" Value="set:skin image:dropDownNormal" />
                    <Property Name="PushedImage" Value="set:skin image:dropDownPushed" />
                </Window>
                <Window Name="GangThanksAlert/smallBg/bgImg/flowerImg" Type="GuiLook/StaticImage">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,1},{0,13},{0,18}}" />
                    <Property Name="Image" Value="set:gangGeneral image:flower" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="FrameEnabled" Value="false" />
                    <Property Name="BackgroundEnabled" Value="false" />
                    <Property Name="RiseOnClick" Value="false" />
                </Window>
                <Window Name="GangThanksAlert/smallBg/bgImg/typeTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,15},{0,0},{0,150},{0,19}}" />
                    <Property Name="Font" Value="" />
                    <Property Name="Text" Value="10(十全十美)" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF85f500" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
        </Window>
    </Window>
</GUILayout>