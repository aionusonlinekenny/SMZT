<GUILayout>
    <Window Name="GourdMountainPrompt" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,360},{0,183}}" />
        <Property Name="Text" Value="挑战失败" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="GourdMountainPrompt/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,346},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="GourdMountainPrompt/cheerImg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,40},{0,19},{0,305},{0,91}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="GourdMountainPrompt/continueBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,65},{0,116},{0,152},{0,139}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="继续挑战" />
        </Window>
        <Window Name="GourdMountainPrompt/leaveBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,188},{0,116},{0,275},{0,139}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="离开副本" />
        </Window>
    </Window>
</GUILayout>