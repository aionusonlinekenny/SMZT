<GUILayout>
    <Window Name="MysteryAlertPanel" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,334},{0,183}}" />
        <Property Name="Text" Value="温馨提示" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="MysteryAlertPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,320},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="MysteryAlertPanel/desc1Txt$RI" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,8},{0,11},{0,309},{0,98}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="进度值已满，已刷出一折物品，是否继续刷新?" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="ffffffff" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="MysteryAlertPanel/okButton" Type="GlossySerpent/OrangeButton">
            <Property Name="UnifiedAreaRect" Value="{{0,37},{0,116},{0,97},{0,139}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="确认" />
        </Window>
        <Window Name="MysteryAlertPanel/cancelButton" Type="GlossySerpent/OrangeButton">
            <Property Name="UnifiedAreaRect" Value="{{0,204},{0,115},{0,264},{0,138}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="取消" />
        </Window>
    </Window>
</GUILayout>