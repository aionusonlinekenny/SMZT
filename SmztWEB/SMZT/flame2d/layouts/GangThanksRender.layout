<GUILayout>
    <Window Name="GangThanksRender" Type="DefaultWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,180},{0,21}}" />
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Window Name="GangThanksRender/bg1" Type="GlossySerpent/ThreeStretchImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,180},{0,21}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="LeftImage" Value="set:skin image:textDiLeft" />
            <Property Name="LeftOffset" Value="46" />
            <Property Name="RightImage" Value="set:skin image:textDiRight" />
            <Property Name="CenterImage" Value="set:skin image:textDiCenter" />
            <Property Name="RightOffset" Value="46" />
        </Window>
        <Window Name="GangThanksRender/flowerImg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,2},{0,13},{0,19}}" />
            <Property Name="Image" Value="set:gangGeneral image:flower" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="GangThanksRender/typeTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,15},{0,1},{0,150},{0,20}}" />
            <Property Name="Font" Value="" />
            <Property Name="Text" Value="10(十全十美)" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF85f500" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
    </Window>
</GUILayout>