<GUILayout>
    <Window Name="EmailAlert" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,1},{0,0},{0,361},{0,183}}" />
        <Property Name="Text" Value="拆分" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="EmailAlert/sure" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,137},{0,116},{0,224},{0,139}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="确定" />
        </Window>
        <Window Name="EmailAlert/wordTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,70},{0,20},{0,290},{0,42}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="确认放入数量？" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="EmailAlert/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,346},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="EmailAlert/wordTxt2" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,70},{0,51},{0,106},{0,73}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="放入" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="ffaaaaaa" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="EmailAlert/inputImg" Type="GlossySerpent/ThreeStretchImage">
            <Property Name="UnifiedAreaRect" Value="{{0,131},{0,52},{0,250},{0,73}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="111" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="LeftImage" Value="set:skin image:EditBox_L" />
            <Property Name="LeftOffset" Value="4" />
            <Property Name="RightImage" Value="set:skin image:EditBox_R" />
            <Property Name="CenterImage" Value="set:skin image:EditBox_M" />
            <Property Name="RightOffset" Value="4" />
            <Window Name="EmailAlert/inputImg/inputTxt" Type="GuiLook/Editbox">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,119},{0,21}}" />
                <Property Name="HorizontalAlignment" Value="Centre" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
        </Window>
        <Window Name="EmailAlert/reductionBtn" Type="GuiLook/DefaultImageButton">
            <Property Name="UnifiedAreaRect" Value="{{0,108},{0,52},{0,129},{0,73}}" />
            <Property Name="Image" Value="set:skin image:reductionBtn" />
        </Window>
        <Window Name="EmailAlert/addBtn" Type="GuiLook/DefaultImageButton">
            <Property Name="UnifiedAreaRect" Value="{{0,252},{0,52},{0,273},{0,73}}" />
            <Property Name="Image" Value="set:skin image:addBtn" />
        </Window>
    </Window>
</GUILayout>