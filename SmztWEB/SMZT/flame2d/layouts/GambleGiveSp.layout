<GUILayout>
    <Window Name="GambleGiveSp" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,360},{0,183}}" />
        <Property Name="Font" Value="songti_18_strengh" />
        <Property Name="Text" Value="提示" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="GambleGiveSp/dataTxt1" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,18},{0,17.5},{0,277},{0,45.5}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="为感谢您对神魔诛天的支持，将赠送您" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="GambleGiveSp/line1" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,111},{0,346},{0,112}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="GambleGiveSp/sendSpTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,-1},{0,79},{0,345},{0,108}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="每天0点会获得体力赠送" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF85f500" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="GambleGiveSp/getBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,135},{0,116},{0,216},{0,139}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="领取" />
        </Window>
        <Window Name="GambleGiveSp/dataTxt2" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,275},{0,17.5},{0,348},{0,45.5}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="体力100点" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFFF7200" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="GambleGiveSp/dataTxt3" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,118},{0,48},{0,246},{0,76}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="请注意领取!" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
    </Window>
</GUILayout>