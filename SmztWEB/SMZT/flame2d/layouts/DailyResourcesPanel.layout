<GUILayout>
    <Window Name="DailyResourcesPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,707},{0,453}}" />
        <Property Name="Text" Value="找回" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="DailyResourcesPanel/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,689},{0,362}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="DailyResourcesPanel/bg/DefaultWindow" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,4},{0,4},{0,685},{0,354}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
        </Window>
        <Window Name="DailyResourcesPanel/OrangeButton" Type="GlossySerpent/OrangeButton">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,375},{0,87},{0,399}}" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
    </Window>
</GUILayout>