<GUILayout>
    <Window Name="SkillPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,587},{0,491}}" />
        <Property Name="GlyphImage" Value="set:skill image:skillTitleTxt" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="DragMovingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
            <Property Name="DraggingEnabled" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="SkillPanel/line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,448},{0,569},{0,449}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="SkillPanel/skillPointSp" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,469},{0,1},{0,569},{0,28}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="SkillPanel/skillPointSp/skillPointBg" Type="GuiLook/TextBG">
                <Property Name="UnifiedAreaRect" Value="{{0,13},{0,3},{0,99},{0,24}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="SkillPanel/skillPointSp/skillPointBg/skillPointTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,15},{0,1},{0,85},{0,20}}" />
                    <Property Name="Font" Value="songti_12_strengh" />
                    <Property Name="Text" Value="13500000" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FFcc43ff" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
            <Window Name="SkillPanel/skillPointSp/skillPointImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,26},{0,27}}" />
                <Property Name="Image" Value="set:skill image:logo" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="Tooltip" Value="20107" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
            </Window>
        </Window>
        <Window Name="SkillPanel/radioTab0" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,8},{0,4},{0,66},{0,28}}" />
            <Property Name="Text" Value="技能" />
        </Window>
        <Window Name="SkillPanel/sp" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,29},{0,569},{0,443}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="SkillPanel/radioTab2" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,67},{0,4},{0,125},{0,28}}" />
            <Property Name="Text" Value="抗性" />
        </Window>
        <Window Name="SkillPanel/upPointImg0" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,-3},{0,18},{0,15}}" />
            <Property Name="Image" Value="set:skin image:promptBg" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="ClippedByParent" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
