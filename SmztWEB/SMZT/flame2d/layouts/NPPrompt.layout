<GUILayout>
    <Window Name="NPPrompt" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,360},{0,183}}" />
        <Property Name="Text" Value="提示" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="NPPrompt/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,111},{0,346},{0,112}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="NPPrompt/descTxt1" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,346},{0,30}}" />
            <Property Name="Font" Value="songti_24_strengh" />
            <Property Name="Text" Value="传送法阵启动中" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="ff85f500" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="NPPrompt/descTxt2" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,80},{0,346},{0,98}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="您将在4秒后到达目的地" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="NPPrompt/transferBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,129},{0,118},{0,216},{0,140}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="立即传送" />
        </Window>
    </Window>
</GUILayout>