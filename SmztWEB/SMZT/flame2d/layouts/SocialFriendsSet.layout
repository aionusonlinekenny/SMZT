        </Window>
        <Window Name="SocialFriendsSet/radioButton3" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,232},{0,4},{0,307},{0,28}}" />
            <Property Name="Font" Value="songti_14_strengh" />
