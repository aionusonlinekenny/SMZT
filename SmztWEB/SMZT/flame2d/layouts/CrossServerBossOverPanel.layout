<GUILayout>
    <Window Name="CrossServerBossOverPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,351},{0,295}}" />
        <Property Name="Text" Value="跨服BOSS奖励" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_clickPos__">
            <Property Name="ClippedByParent" Value="false" />
        </AutoWindow>
        <Window Name="CrossServerBossOverPanel/lineBottom" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,252},{0,333},{0,253}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="CrossServerBossOverPanel/commonBg3" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,333},{0,218}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="CrossServerBossOverPanel/commonBg3/line" Type="GuiLook/Line">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,45},{0,333},{0,46}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
            <Window Name="CrossServerBossOverPanel/commonBg3/txt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,13},{0,333},{0,33}}" />
                <Property Name="Font" Value="songti_14" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FFFF7200" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="CrossServerBossOverPanel/commonBg3/dataGridWin" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,79},{0,72},{0,251},{0,183}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
        </Window>
        <Window Name="CrossServerBossOverPanel/sureBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,222},{0,118},{0,246}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="确定" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
    </Window>
</GUILayout>