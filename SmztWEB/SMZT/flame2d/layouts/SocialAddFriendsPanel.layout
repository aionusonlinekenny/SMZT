<GUILayout>
    <Window Name="SocialAddFriendsPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,483},{0,335}}" />
        <Property Name="Text" Value="添加好友" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="SocialAddFriendsPanel/leftSp" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,200},{0,260}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="SocialAddFriendsPanel/leftSp/titleTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,30},{0,109},{0,48}}" />
                <Property Name="Font" Value="songti_12_strengh" />
                <Property Name="Text" Value="输入玩家名称查找" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FF65b3e9" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="HorizontalAlignment" Value="Centre" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="SocialAddFriendsPanel/leftSp/textBG" Type="GuiLook/TextBG">
                <Property Name="UnifiedAreaRect" Value="{{0,20},{0,53},{0,160},{0,74}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="SocialAddFriendsPanel/leftSp/textBG/inputTxt" Type="GuiLook/Editbox">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,-5},{0,140},{0,25}}" />
                </Window>
            </Window>
            <Window Name="SocialAddFriendsPanel/leftSp/findBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,163},{0,53},{0,183},{0,72}}" />
                <Property Name="HoverImage" Value="set:mainUI1 image:boxHover" />
                <Property Name="NormalImage" Value="set:mainUI1 image:boxNormal" />
                <Property Name="PushedImage" Value="set:mainUI1 image:boxPushed" />
                <Window Name="SocialAddFriendsPanel/leftSp/findBtn/findImg" Type="GuiLook/StaticImage">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,20},{0,20}}" />
                    <Property Name="Image" Value="set:mainUI1 image:checkImg" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="FrameEnabled" Value="false" />
                    <Property Name="HorzFormatting" Value="CentreAligned" />
                    <Property Name="VertFormatting" Value="CentreAligned" />
                    <Property Name="BackgroundEnabled" Value="false" />
                    <Property Name="RiseOnClick" Value="false" />
                    <Property Name="MouseButtonDownAutoRepeat" Value="true" />
                    <Property Name="MousePassThroughEnabled" Value="true" />
                    <Property Name="MouseInputPropagationEnabled" Value="true" />
                </Window>
            </Window>
            <Window Name="SocialAddFriendsPanel/leftSp/faceBg" Type="GuiLook/StaticImage">
