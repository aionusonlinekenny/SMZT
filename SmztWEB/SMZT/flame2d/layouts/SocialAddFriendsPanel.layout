            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="SocialAddFriendsPanel/rightSp" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,199},{0,4},{0,464},{0,260}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="SocialAddFriendsPanel/rightSp/rightBg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,265},{0,256}}" />
                <Property Name="Image" Value="set:friendsBg2 image:shake" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="HorzFormatting" Value="CentreAligned" />
                <Property Name="VertFormatting" Value="CentreAligned" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Window Name="SocialAddFriendsPanel/rightSp/rightBg/list" Type="DefaultWindow">
                    <Property Name="UnifiedAreaRect" Value="{{0,4},{0,4},{0,262},{0,252}}" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                </Window>
            </Window>
        </Window>
        <Window Name="SocialAddFriendsPanel/addBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,49},{0,265},{0,161},{0,288}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="加为好友" />
