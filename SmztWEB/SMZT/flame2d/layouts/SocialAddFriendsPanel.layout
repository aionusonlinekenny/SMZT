            <Window Name="SocialAddFriendsPanel/leftSp/fightTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,97},{0,224},{0,183},{0,242}}" />
                <Property Name="Font" Value="songti_12_strengh" />
                <Property Name="Text" Value="1234567" />
