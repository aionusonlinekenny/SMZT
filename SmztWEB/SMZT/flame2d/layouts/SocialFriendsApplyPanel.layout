<GUILayout>
    <Window Name="SocialFriendsApplyPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,365},{0,266}}" />
        <Property Name="Text" Value="好友申请" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="SocialFriendsApplyPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,223},{0,347},{0,224}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="SocialFriendsApplyPanel/CommonBg3" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,347},{0,191}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="SocialFriendsApplyPanel/CommonBg3/DefaultWindow" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,347},{0,155}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
            <Window Name="SocialFriendsApplyPanel/CommonBg3/backBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,129},{0,160},{0,149},{0,180}}" />
                <Property Name="HoverImage" Value="set:skin image:LastBtnHover" />
                <Property Name="NormalImage" Value="set:skin image:LastBtnNormal" />
                <Property Name="PushedImage" Value="set:skin image:LastBtnPushed" />
            </Window>
            <Window Name="SocialFriendsApplyPanel/CommonBg3/nextBtn" Type="GuiLook/DefaultButton">
                <Property Name="UnifiedAreaRect" Value="{{0,200},{0,160},{0,220},{0,180}}" />
                <Property Name="HoverImage" Value="set:skin image:NextBtnHover" />
                <Property Name="NormalImage" Value="set:skin image:NextBtnNormal" />
                <Property Name="PushedImage" Value="set:skin image:NextBtnPushed" />
            </Window>
            <Window Name="SocialFriendsApplyPanel/CommonBg3/pageBg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,1},{0,161},{0,43},{0,179}}" />
                <Property Name="Image" Value="set:skin image:pageBg" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Property Name="HorizontalAlignment" Value="Centre" />
                <Window Name="SocialFriendsApplyPanel/CommonBg3/pageBg/pageTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,42},{0,18}}" />
                    <Property Name="Font" Value="songti_12_strengh" />
                    <Property Name="Text" Value="1/10" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="TextColour" Value="FF58eafe" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
        </Window>
        <Window Name="SocialFriendsApplyPanel/agreeBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,61},{0,194},{0,149},{0,220}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="全部同意" />
        </Window>
        <Window Name="SocialFriendsApplyPanel/refusedBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,201},{0,194},{0,289},{0,220}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="全部拒绝" />
        </Window>
    </Window>
</GUILayout>