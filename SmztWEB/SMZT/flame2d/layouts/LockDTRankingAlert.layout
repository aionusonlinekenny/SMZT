<GUILayout>
    <Window Name="LockDTRankingAlert" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,234},{0,525}}" />
        <Property Name="Font" Value="songti_16_strengh" />
        <Property Name="Text" Value="副本排行" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="LockDTRankingAlert/boxlist" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,216},{0,375}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="LockDTRankingAlert/desc1Txt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,-1},{0,384},{0,59},{0,402}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="每日奖励：" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="fffef9d0" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="LockDTRankingAlert/desc2Txt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,407},{0,60},{0,425}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="领取时间：" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="fffef9d0" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="LockDTRankingAlert/getBtn" Type="GuiLook/DefaultButton">
            <Property Name="UnifiedAreaRect" Value="{{0,35},{0,435},{0,147},{0,466}}" />
            <Property Name="HoverImage" Value="set:skins image:BlueBtnHover" />
            <Property Name="NormalImage" Value="set:skins image:BlueBtnNormal" />
            <Property Name="PushedImage" Value="set:skins image:BlueBtnPushed" />
            <Window Name="LockDTRankingAlert/getBtn/receiveImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,112},{0,31}}" />
                <Property Name="Image" Value="set:LockDemonTowerGeneral image:receiveReward" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="HorzFormatting" Value="CentreAligned" />
                <Property Name="VertFormatting" Value="CentreAligned" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Property Name="MousePassThroughEnabled" Value="true" />
            </Window>
        </Window>
        <Window Name="LockDTRankingAlert/linkBtn" Type="GuiLook/DefaultButton">
            <Property Name="UnifiedAreaRect" Value="{{0,156},{0,435},{0,187},{0,466}}" />
            <Property Name="HoverImage" Value="set:LockDemonTowerGeneral image:rankingHover" />
            <Property Name="NormalImage" Value="set:LockDemonTowerGeneral image:rankingNormal" />
            <Property Name="PushedImage" Value="set:LockDemonTowerGeneral image:rankingPushed" />
        </Window>
        <Window Name="LockDTRankingAlert/rewardTxt$RI" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,60},{0,384},{0,224},{0,402}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="经验 6000" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FF85f500" />
            <Property Name="VertFormatting" Value="TOPAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="LockDTRankingAlert/timeTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,61},{0,407},{0,223},{0,425}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="————" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFFFEA00" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
    </Window>
</GUILayout>