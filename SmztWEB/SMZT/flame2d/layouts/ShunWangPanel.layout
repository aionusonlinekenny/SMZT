        <Window Name="ShunWangPanel/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,164},{0,4},{0,759},{0,484}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="ShunWangPanel/Line" Type="GuiLook/Line">
