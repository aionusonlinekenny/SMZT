        </Window>
        <Window Name="DancePrompt/descTxt1" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,11},{0,45},{0,287},{0,67}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="参与每日广场舞活动可获得大量经验奖励" />
