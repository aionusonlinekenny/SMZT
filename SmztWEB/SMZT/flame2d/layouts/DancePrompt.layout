            <Property Name="TextColour" Value="ff43f850" />
            <Property Name="WantsMultiClickEvents" Value="false" />
            <Property Name="MousePassThroughEnabled" Value="true" />
        </Window>
        <Window Name="DancePrompt/descTxt2" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,10},{0,113},{0,286},{0,135}}" />
            <Property Name="Font" Value="songti_12_strengh" />
