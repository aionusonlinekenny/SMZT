            <Property Name="TextColour" Value="ffe1feff" />
            <Property Name="HorzTextFormatting" Value="CentreAligned" />
            <Property Name="WantsMultiClickEvents" Value="false" />
            <Property Name="MousePassThroughEnabled" Value="true" />
        </Window>
        <Window Name="DancePrompt/txt$RI" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,108},{0,80},{0,271},{0,102}}" />
            <Property Name="Font" Value="songti_12_strengh" />
            <Property Name="Text" Value="12:45-12:55/18:45-18:55" />
