<GUILayout>
    <Window Name="YJTDCardPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,784},{0,449}}" />
        <Property Name="GlyphImage" Value="set:nineSword image:bless" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="YJTDCardPanel/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,766},{0,401}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="YJTDCardPanel/bg/clickImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,286},{0,336},{0,477},{0,359}}" />
                <Property Name="Image" Value="set:nineSword image:click" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
            </Window>
            <Window Name="YJTDCardPanel/bg/descTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,39},{0,766},{0,63}}" />
                <Property Name="Font" Value="songti_18_strengh" />
                <Property Name="Text" Value="请等待            正在翻牌        秒后自动翻牌" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="ff00baff" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="YJTDCardPanel/bg/nameTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,216},{0,39},{0,349},{0,63}}" />
                <Property Name="Font" Value="songti_18_strengh" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FF85f500" />
                <Property Name="HorzTextFormatting" Value="CentreAligned" />
                <Property Name="RiseOnClick" Value="false" />
                <Property Name="WantsMultiClickEvents" Value="false" />
                <Property Name="MousePassThroughEnabled" Value="true" />
            </Window>
            <Window Name="YJTDCardPanel/bg/timeTxt" Type="GuiLook/StaticText">
                <Property Name="UnifiedAreaRect" Value="{{0,390},{0,39},{0,478},{0,63}}" />
                <Property Name="Font" Value="songti_18_strengh" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="TextColour" Value="FF85f500" />
                <Property Name="HorzTextFormatting" Value="RightAligned" />
                <Property Name="WantsMultiClickEvents" Value="false" />
            </Window>
            <Window Name="YJTDCardPanel/bg/list" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,18},{0,98},{0,748},{0,292}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            </Window>
        </Window>
        <Window Name="YJTDCardPanel/sureBtn" Type="GlossySerpent/RedButton">
            <Property Name="UnifiedAreaRect" Value="{{0,286},{0,334},{0,477},{0,374}}" />
            <Property Name="ClippedByParent" Value="false" />
            <Window Name="YJTDCardPanel/sureBtn/sureImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,191},{0,40}}" />
                <Property Name="Image" Value="set:nineSword image:sure" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="HorzFormatting" Value="CentreAligned" />
                <Property Name="VertFormatting" Value="CentreAligned" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Property Name="MousePassThroughEnabled" Value="true" />
            </Window>
        </Window>
    </Window>
</GUILayout>