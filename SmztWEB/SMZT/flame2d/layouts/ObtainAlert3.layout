<GUILayout>
    <Window Name="ObtainAlert3" Type="GuiLook/Panel2">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,334},{0,183}}" />
        <Property Name="Text" Value="获得魔兵" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="ObtainAlert3/prop" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,18},{0,34},{0,66},{0,82}}" />
            <Property Name="Image" Value="set:skin image:GridBG" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="ObtainAlert3/desc1Txt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,93},{0,67},{0,227},{0,85}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="神器属性&lt;未鉴定&gt;" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="ffff0000" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="ObtainAlert3/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,110},{0,320},{0,111}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="ObtainAlert3/descTxt" Type="GuiLook/StaticText">
            <Property Name="UnifiedAreaRect" Value="{{0,90},{0,26},{0,241},{0,50}}" />
            <Property Name="Font" Value="songti_18_strengh" />
            <Property Name="Text" Value="魔兵丶二度烧伤" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="TextColour" Value="FFffea00" />
            <Property Name="WantsMultiClickEvents" Value="false" />
        </Window>
        <Window Name="ObtainAlert3/OrangeButton" Type="GlossySerpent/OrangeButton">
            <Property Name="UnifiedAreaRect" Value="{{0,113},{0,117},{0,200},{0,140}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="立即鉴定" />
        </Window>
        <Window Name="ObtainAlert3/godEquipImg" Type="GuiLook/StaticImage">
            <Property Name="UnifiedAreaRect" Value="{{0,246},{0,23},{0,301},{0,54}}" />
            <Property Name="Image" Value="set:skins image:godProduct" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Property Name="FrameEnabled" Value="false" />
            <Property Name="BackgroundEnabled" Value="false" />
            <Property Name="RiseOnClick" Value="false" />
        </Window>
        <Window Name="ObtainAlert3/fightView" Type="DefaultWindow">
            <Property Name="UnifiedAreaRect" Value="{{0,89},{0,65},{0,296},{0,88}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="ObtainAlert3/fightView/fightNumberImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,67},{0,0},{0,195},{0,22}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
            </Window>
            <Window Name="ObtainAlert3/fightView/fightImg" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,2},{0,0},{0,66},{0,22}}" />
                <Property Name="Image" Value="set:mainUI1 image:fightText" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
            </Window>
        </Window>
    </Window>
</GUILayout>