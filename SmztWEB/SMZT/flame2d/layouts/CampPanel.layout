<GUILayout>
    <Window Name="CampPanel" Type="GuiLook/NewWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,31},{0,51},{0,1033},{0,699}}" />
        <Property Name="GlyphImage" Value="set:cityGeneral image:sky" />
        <Property Name="RollUpEnabled" Value="false" />
        <Property Name="SizingEnabled" Value="false" />
        <Property Name="RiseOnClick" Value="true" />
        <Property Name="AutoRenderingSurface" Value="false" />
        <AutoWindow NameSuffix="__auto_titlebar__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="false" />
        </AutoWindow>
        <AutoWindow NameSuffix="__auto_closebutton__">
            <Property Name="NonClient" Value="true" />
            <Property Name="AlwaysOnTop" Value="true" />
        </AutoWindow>
        <Window Name="CampPanel/background" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,31},{0,984},{0,602}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
        <Window Name="CampPanel/tabBtn" Type="GuiLook/CommonRadioButton">
            <Property Name="UnifiedAreaRect" Value="{{0,6},{0,5},{0,81},{0,29}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="大魏天子" />
            <Window Name="CampPanel/tabBtn/numFlag" Type="GuiLook/StaticImage">
                <Property Name="UnifiedAreaRect" Value="{{0,59},{0,-2},{0,77},{0,16}}" />
                <Property Name="Image" Value="set:skin image:promptBg" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Property Name="Visible" Value="false" />
                <Property Name="FrameEnabled" Value="false" />
                <Property Name="BackgroundEnabled" Value="false" />
                <Property Name="RiseOnClick" Value="false" />
                <Window Name="CampPanel/tabBtn/numFlag/numTxt" Type="GuiLook/StaticText">
                    <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,18},{0,18}}" />
                    <Property Name="Font" Value="" />
                    <Property Name="Text" Value="!" />
                    <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                    <Property Name="HorzTextFormatting" Value="CentreAligned" />
                    <Property Name="WantsMultiClickEvents" Value="false" />
                </Window>
            </Window>
        </Window>
        <Window Name="CampPanel/Line" Type="GuiLook/Line">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,606},{0,984},{0,607}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        </Window>
    </Window>
</GUILayout>