<GUILayout>
    <Window Name="SocialFriendsSetReply" Type="DefaultWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,312},{0,276}}" />
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Window Name="SocialFriendsSetReply/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,312},{0,249}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="SocialFriendsSetReply/bg/checkbox" Type="GuiLook/Checkbox">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,19},{0,103},{0,35}}" />
