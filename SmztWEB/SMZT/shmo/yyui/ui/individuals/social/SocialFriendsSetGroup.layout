<GUILayout>
    <Window Name="SocialFriendsSetGroup" Type="DefaultWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,312},{0,276}}" />
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Window Name="SocialFriendsSetGroup/bg" Type="GuiLook/CommonBg3">
