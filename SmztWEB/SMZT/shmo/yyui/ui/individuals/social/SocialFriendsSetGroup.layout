                <Property Name="UnifiedAreaRect" Value="{{0,2},{0,2},{0,310},{0,213}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="SocialFriendsSetGroup/bg/list/addBtn" Type="GuiLook/DefaultButton">
