<GUILayout>
    <Window Name="SocialFriendsSetDelete" Type="DefaultWindow">
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,312},{0,276}}" />
        <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
        <Window Name="SocialFriendsSetDelete/sureBtn" Type="GlossySerpent/BlueButton">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,251},{0,80},{0,274}}" />
            <Property Name="Font" Value="songti_14_strengh" />
            <Property Name="Text" Value="删除" />
            <Property Name="HorizontalAlignment" Value="Centre" />
        </Window>
        <Window Name="SocialFriendsSetDelete/bg" Type="GuiLook/CommonBg3">
            <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,312},{0,249}}" />
            <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
            <Window Name="SocialFriendsSetDelete/bg/combobox" Type="GuiLook/Combobox">
                <Property Name="UnifiedAreaRect" Value="{{0,4},{0,4},{0,307},{0,54}}" />
                <Property Name="Font" Value="songti_12_strengh" />
                <Property Name="Text" Value="好友" />
                <Property Name="NormalEditTextColour" Value="ffffffff" />
                <AutoWindow NameSuffix="__auto_editbox__">
                    <Property Name="Font" Value="songti_12_strengh" />
                    <Property Name="Text" Value="好友" />
                    <Property Name="NormalTextColour" Value="ffffffff" />
                    <Property Name="SelectedTextColour" Value="FFFFFFDD" />
                    <Property Name="ActiveSelectionColour" Value="FFFFB080" />
                    <Property Name="InactiveSelectionColour" Value="FFB18A50" />
                </AutoWindow>
                <AutoWindow NameSuffix="__auto_droplist__">
                    <Property Name="Font" Value="songti_12_strengh" />
                    <AutoWindow NameSuffix="__auto_hscrollbar__">
                        <AutoWindow NameSuffix="__auto_incbtn__">
                            <Property Name="RestoreOldCapture" Value="true" />
                        </AutoWindow>
                        <AutoWindow NameSuffix="__auto_decbtn__">
                            <Property Name="RestoreOldCapture" Value="true" />
                        </AutoWindow>
                        <AutoWindow NameSuffix="__auto_thumb__">
                            <Property Name="RestoreOldCapture" Value="true" />
                        </AutoWindow>
                    </AutoWindow>
                    <AutoWindow NameSuffix="__auto_vscrollbar__">
                        <Property Name="VerticalScrollbar" Value="true" />
                        <AutoWindow NameSuffix="__auto_incbtn__">
                            <Property Name="RestoreOldCapture" Value="true" />
                        </AutoWindow>
                        <AutoWindow NameSuffix="__auto_decbtn__">
                            <Property Name="RestoreOldCapture" Value="true" />
                        </AutoWindow>
                        <AutoWindow NameSuffix="__auto_thumb__">
                            <Property Name="RestoreOldCapture" Value="true" />
                        </AutoWindow>
                    </AutoWindow>
                </AutoWindow>
                <AutoWindow NameSuffix="__auto_button__">
                    <Property Name="AlwaysOnTop" Value="true" />
                </AutoWindow>
            </Window>
            <Window Name="SocialFriendsSetDelete/bg/headListSp" Type="DefaultWindow">
                <Property Name="UnifiedAreaRect" Value="{{0,0},{0,32},{0,312},{0,60}}" />
                <Property Name="UnifiedMaxSize" Value="{{1,0},{1,0}}" />
                <Window Name="SocialFriendsSetDelete/bg/headListSp/headListBg" Type="GlossySerpent/ThreeStretchImage">
