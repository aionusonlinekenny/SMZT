            <Property Name="TextColour" Value="ffffd800" />
            <Property Name="UnifiedAreaRect" Value="{{0,145},{0,51},{0,210},{0,70}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
        </Window>
        <Window Type="GuiLook/StaticText" Name="ItemTooltips/typetext" >
