            </Window>
        </Window>
        <Window Type="DefaultWindow" Name="ItemTooltips/bottomgroup" >
            <Property Name="UnifiedAreaRect" Value="{{0,12},{0,194},{0,295},{0,236}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
            <Window Type="GuiLook/Line" Name="ItemTooltips/line11" >
