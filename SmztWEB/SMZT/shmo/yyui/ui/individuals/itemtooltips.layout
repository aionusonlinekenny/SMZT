<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="GuiLook/TooltipPanel" Name="ItemTooltips" >
        <Property Name="UnifiedAreaRect" Value="{{0,318},{0,79},{0,618},{0,321}}" />
        <Property Name="MousePassThroughEnabled" Value="True" />
        <Window Type="GuiLook/StaticTextBox" Name="ItemTooltips/titletext" >
            <Property Name="Font" Value="宋体3" />
            <Property Name="Text" Value="追风项链" />
            <Property Name="TextColours" Value="FF00FF00" />
            <Property Name="FrameEnabled" Value="False" />
            <Property Name="HorzFormatting" Value="HorzCentred" />
            <Property Name="VertFormatting" Value="VertCentred" />
            <Property Name="UnifiedAreaRect" Value="{{0,17},{0,4},{0,282},{0,29}}" />
            <Property Name="BackgroundEnabled" Value="False" />
            <Property Name="MousePassThroughEnabled" Value="True" />
        </Window>
        <Window Type="GuiLook/StaticText" Name="ItemTooltips/postitle" >
            <Property Name="Font" Value="宋体" />
