            <Property Name="TextColour" Value="ffc1eeec" />
            <Property Name="UnifiedAreaRect" Value="{{0,209},{0,71},{0,274},{0,90}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
        </Window>
        <Window Type="GuiLook/StaticText" Name="ItemTooltips/postitle11" >
